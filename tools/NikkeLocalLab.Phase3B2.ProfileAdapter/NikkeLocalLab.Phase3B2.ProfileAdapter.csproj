<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <Target Name="RequireEpinelProjectPath" BeforeTargets="ResolveProjectReferences">
    <Error Condition="'$(EpinelProjectPath)' == ''"
           Text="Set EpinelProjectPath to the exact pinned EpinelPS.csproj path." />
  </Target>

  <ItemGroup>
    <ProjectReference Include="$(EpinelProjectPath)" />
  </ItemGroup>
</Project>
