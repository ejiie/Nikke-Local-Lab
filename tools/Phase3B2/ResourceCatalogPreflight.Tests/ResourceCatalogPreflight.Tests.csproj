<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsTestProject>true</IsTestProject>
    <IsPackable>false</IsPackable>
    <EpinelRuntimeRoot Condition="'$(EpinelRuntimeRoot)' == ''">$(MSBuildThisFileDirectory)..\..\..\.external\EpinelPS\EpinelPS\bin\Release\net10.0\win-x64</EpinelRuntimeRoot>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="..\EpinelResourceProbe\ResourceProbeExecution.cs" Link="EpinelProbe\ResourceProbeExecution.cs" />
    <Compile Include="..\ResourceProbeBootstrap\ResourceProbeBootstrapSettings.cs" Link="BootstrapProbe\ResourceProbeBootstrapSettings.cs" />
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" PrivateAssets="all" />
    <ProjectReference Include="..\ResourceCatalogPreflight\ResourceCatalogPreflight.csproj" />
    <Reference Include="Microsoft.Data.Sqlite" HintPath="$(EpinelRuntimeRoot)\Microsoft.Data.Sqlite.dll" Private="true" />
    <Reference Include="ZstdSharp" HintPath="$(EpinelRuntimeRoot)\ZstdSharp.dll" Private="true" />
  </ItemGroup>
</Project>
