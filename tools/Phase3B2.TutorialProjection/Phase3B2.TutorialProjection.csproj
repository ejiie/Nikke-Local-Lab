<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EpinelRuntimeRoot Condition="'$(EpinelRuntimeRoot)' == ''">E:\NLL\EpinelPS\EpinelPS\bin\Release\net10.0\win-x64</EpinelRuntimeRoot>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="EpinelPS">
      <HintPath>$(EpinelRuntimeRoot)\EpinelPS.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Content Include="$(EpinelRuntimeRoot)\*.dll">
      <Link>%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="$(EpinelRuntimeRoot)\gameconfig.json">
      <Link>gameconfig.json</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="$(EpinelRuntimeRoot)\appsettings.json">
      <Link>appsettings.json</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>
</Project>
