diff --git a/tests/EpinelPS.SelectedManager.Tests/RaidDamageCaptureTests.cs b/tests/EpinelPS.SelectedManager.Tests/RaidDamageCaptureTests.cs
--- /dev/null
+++ b/tests/EpinelPS.SelectedManager.Tests/RaidDamageCaptureTests.cs
@@ -0,0 +1,59 @@
+using EpinelPS;
+using EpinelPS.Models;
+using EpinelPS.Database;
+using EpinelPS.LobbyServer.Guild;
+using EpinelPS.LobbyServer.Soloraid;
+using Newtonsoft.Json;
+using Xunit;
+
+namespace EpinelPS.SelectedManager.Tests;
+
+public sealed class RaidDamageCaptureTests
+{
+    [Fact]
+    public void NumericProjectionPreservesInt64NullAndZeroWithoutSourceIdentifiers()
+    {
+        var uid=Guid.NewGuid();var user=new User {LocalPersistenceBinding=new(){AccountUid=Guid.NewGuid(),CharacterUidByCsn=new(){[123]=uid.ToString()}}};
+        var report=new NetAntiCheatBattleData{BattleDuration=180};
+        report.Characters.Add(new NetAntiCheatCharacter(){Csn=123,Tid=456,Slot=2,Attack=new(){TotalDamage=9_000_000_007,TotalActualDamage=8_000_000_003},Skill=new()});
+        report.Monsters.Add(new NetAntiCheatMonster(){Hp=new(){TotalDamageReceived=10_000_000_001,TotalActualDamageReceived=7,TotalPartsDestroyDamageReceived=11,TotalProjectileDamageReceived=13}});
+        report.Monsters.Add(new NetAntiCheatMonster());
+        var value=RaidDamageObservation.Capture(user,report,Guid.NewGuid(),"union_hard_practice",2,3,4,1,10,8,DateTimeOffset.UtcNow);
+        var restored=JsonConvert.DeserializeObject<RaidDamageObservation>(JsonConvert.SerializeObject(value))!;
+        var c=Assert.Single(restored.Characters);Assert.Equal(uid,c.CharacterUid);Assert.Equal(9_000_000_007,c.Attack!.TotalDamage);
+        Assert.Equal(8_000_000_003,c.Attack.TotalActualDamage);Assert.Equal(0,c.Skill!.TotalDamage);Assert.Null(c.StatFunctionAttack);
+        Assert.Equal(11,restored.Monsters[0].Hp!.TotalPartsDestroyDamageReceived);Assert.Equal(13,restored.Monsters[0].Hp!.TotalProjectileDamageReceived);
+        Assert.Null(restored.Monsters[1].Hp);Assert.Equal(180,restored.BattleDuration);
+        var json=JsonConvert.SerializeObject(value);Assert.DoesNotContain("Csn",json);Assert.DoesNotContain("Tid",json);Assert.DoesNotContain("BattleLog",json);
+        Assert.False(RaidDamageObservation.Capture(user,null,Guid.NewGuid(),"union_hard",1,1,1,1,0,0,DateTimeOffset.UtcNow).ReportPresent);
+    }
+    [Fact]
+    public void SoloAcceptedReceiptCapturesOnceWhileRetryDoesNotCreateObservation()
+    {
+        var user=ClassicRouteTestFixture.ActiveUser();user.LocalPersistenceBinding=new(){AccountUid=Guid.NewGuid(),DamageCaptureSoloSeason=2};
+        var req=ClassicRouteTestFixture.DamageRequest(44);
+        req.AntiCheatBattleData.Characters.Add(new NetAntiCheatCharacter{Csn=1,Slot=1,CharacterSpec=new(){Level=1},Attack=new(){TotalDamage=900,TotalActualDamage=800}});
+        var response=new ResSetSoloRaidTrialDamage();
+        Assert.True(SoloRaidHelper.SetDamageTrial(user,ref response,req,ClassicRouteTestFixture.TargetManager));
+        Assert.True(SoloRaidHelper.SetDamageTrial(user,ref response,req,ClassicRouteTestFixture.TargetManager));
+        var receipt=Assert.Single(user.SoloRaidData[ClassicRouteTestFixture.TargetManager].BattleHistory);
+        Assert.Equal(receipt.BattleUid,receipt.DamageStatistics!.BattleUid);Assert.Equal(900,receipt.DamageStatistics.Characters[0].Attack!.TotalDamage);
+        var copy=JsonConvert.DeserializeObject<User>(JsonConvert.SerializeObject(user))!;
+        Assert.Equal(receipt.BattleUid,copy.SoloRaidData[ClassicRouteTestFixture.TargetManager].BattleHistory[0].DamageStatistics!.BattleUid);
+        req.BattleResult=4;Assert.True(SoloRaidHelper.SetDamageTrial(user,ref response,req,ClassicRouteTestFixture.TargetManager));
+        Assert.Single(user.SoloRaidData[ClassicRouteTestFixture.TargetManager].BattleHistory);
+    }
+    [Fact]
+    public void UnionPracticeAndRealDamageKeepSeparateKeysAndUnclampedInput()
+    {
+        var user=new User{LocalPersistenceBinding=new(){AccountUid=Guid.NewGuid()},LocalUnionRaid=new(){SeasonNumber=2}};
+        var state=new LocalUnionProgress();var engine=new LocalUnionEngine(user,state,new([new(1,1,100,false)],3,5),DateTimeOffset.UtcNow);
+        engine.Member.Teams[1]=[new(){Slot=1,Character=Guid.NewGuid()}];
+        engine.Enter(1,1,1);var actual=engine.Damage(1,1,1,150,"real",report:new());
+        Assert.Equal(150,actual.DamageStatistics!.RequestDamage);Assert.Equal(100,actual.DamageStatistics.AcceptedDamage);
+        engine.Enter(1,1,0,true);var practice=engine.Damage(1,1,1,70,"practice",true,new(),initialHp:100);
+        Assert.NotEqual(actual.Battle.BattleUid,practice.Battle.BattleUid);Assert.Equal("union_hard_practice",practice.DamageStatistics!.Mode);
+        Assert.Equal(100,practice.DamageStatistics.InitialHp);Assert.Same(practice,engine.Damage(1,1,1,70,"practice",true));
+        Assert.Equal(2,state.Battles.Count);
+    }
+}
