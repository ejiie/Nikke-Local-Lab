diff --git a/tests/EpinelPS.SelectedManager.Tests/ClassicBattleHistoryTests.cs b/tests/EpinelPS.SelectedManager.Tests/ClassicBattleHistoryTests.cs
index fdd1f9d..6d849c6 100644
--- a/tests/EpinelPS.SelectedManager.Tests/ClassicBattleHistoryTests.cs
+++ b/tests/EpinelPS.SelectedManager.Tests/ClassicBattleHistoryTests.cs
@@ -9,6 +9,36 @@ namespace EpinelPS.SelectedManager.Tests;
 
 public sealed class ClassicBattleHistoryTests
 {
+    [Theory]
+    [InlineData(0)]
+    [InlineData(1)]
+    [InlineData(2)]
+    [InlineData(3)]
+    [InlineData(4)]
+    [InlineData(5)]
+    public void LobbyQuitConsumesAttemptAndOnlyFiveDecksCompleteRun(int decks)
+    {
+        var user = ClassicRouteTestFixture.ActiveUser();
+        var raid = user.SoloRaidData[ClassicRouteTestFixture.TargetManager];
+        raid.TrialCount = 1; // Charged once by Open, never refunded by lobby Quit.
+        for (var i = 0; i < decks; i++)
+        {
+            var response = new ResSetSoloRaidTrialDamage();
+            Assert.True(SoloRaidHelper.SetDamageTrial(user, ref response,
+                ClassicRouteTestFixture.DamageRequest(10 + i), ClassicRouteTestFixture.TargetManager));
+        }
+        Assert.Equal(decks < 5, SoloRaidHelper.CloseSoloRaid(user, ClassicRouteTestFixture.TargetManager, 8, SoloRaidType.Trial));
+        Assert.Equal(1, raid.TrialCount);
+        Assert.False(SoloRaidHelper.CloseSoloRaid(user, ClassicRouteTestFixture.TargetManager, 8, SoloRaidType.Trial));
+        Assert.Equal(1, raid.TrialCount);
+        Assert.Equal(decks == 5, SoloRaidHelper.GetBestCompletedTrialLevel(raid, 8) is not null);
+        Assert.Equal(decks, raid.BattleHistory.Count);
+        Assert.Equal(decks == 5 ? 1 : 0, raid.BattleRunStatus.Values.Count(status => status == "completed"));
+        Assert.Equal(1, SoloRaidHelper.GetUserSoloRaidInfo(user, ClassicRouteTestFixture.TargetManager,
+            ClassicRouteTestFixture.RankingDamagePrefix).TrialCount);
+        Assert.DoesNotContain(raid.SoloRaidLevels, level => level.IsOpen);
+    }
+
     [Fact]
     public void LegacyKnownDecksRemainVisibleAndQuitDoesNotRewriteBattleSnapshots()
     {
