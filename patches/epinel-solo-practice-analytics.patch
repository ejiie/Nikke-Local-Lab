+    [Fact]
+    public void PracticeCapturesAcceptedReportOnceAndPreservesItsKeyAcrossSerialization()
+    {
+        var user = ClassicRouteTestFixture.ActiveUser();
+        user.LocalPersistenceBinding = new() { AccountUid = Guid.NewGuid(), DamageCaptureSoloSeason = 2 };
+        var raid = user.SoloRaidData[ClassicRouteTestFixture.TargetManager];
+        foreach (var level in raid.SoloRaidLevels) level.Type = SoloRaidType.Practice;
+        var trial = ClassicRouteTestFixture.DamageRequest(44);
+        var req = new ReqSetSoloRaidPracticeDamage { RaidLevel = 8, Damage = trial.Damage, AntiCheatBattleData = trial.AntiCheatBattleData };
+        req.AntiCheatBattleData.Characters.Add(new NetAntiCheatCharacter { Csn = 1, Slot = 1, CharacterSpec = new() { Level = 1 }, Attack = new() { TotalDamage = 900 } });
+        var response = new ResSetSoloRaidPracticeDamage();
+        Assert.True(SoloRaidHelper.SetDamagePractice(user, ref response, req, ClassicRouteTestFixture.TargetManager));
+        Assert.True(SoloRaidHelper.SetDamagePractice(user, ref response, req, ClassicRouteTestFixture.TargetManager));
+        var receipt = Assert.Single(raid.BattleHistory);
+        Assert.Equal("solo_challenge_practice", receipt.DamageStatistics!.Mode);
+        Assert.Equal(receipt.BattleUid, receipt.DamageStatistics.BattleUid);
+        Assert.Equal(900, receipt.DamageStatistics.Characters[0].Attack!.TotalDamage);
+        var restored = JsonConvert.DeserializeObject<RaidDamageObservation>(JsonConvert.SerializeObject(receipt.DamageStatistics))!;
+        Assert.Equal("missing", restored.ProjectileAnalysis!.Status);
+        Assert.Equal(receipt.BattleUid, restored.BattleUid);
+    }
