+using EpinelPS.Data;
+
+namespace EpinelPS.LobbyServer.Guild;
+
+public sealed record LocalUnionTier(int Step, int Level, long Hp, bool Trial);
+
+public sealed record LocalUnionContent(IReadOnlyList<LocalUnionTier> Tiers, int Entries, int Teams)
+{
+    public LocalUnionTier Tier(int step,int level) => Tiers.SingleOrDefault(x=>x.Step==step && x.Level==level)
+        ?? throw new InvalidOperationException("local_union_stage_unresolved");
+
+    private static readonly System.Runtime.CompilerServices.ConditionalWeakTable<GameData,System.Collections.Concurrent.ConcurrentDictionary<int,LocalUnionContent>> Cache=new();
+    public static LocalUnionContent Resolve(User user) => Cache.GetOrCreateValue(GameData.Instance)
+        .GetOrAdd(user.LocalUnionRaid?.ManagerTid ?? 0,_=>Resolve(user,GameData.Instance));
+
+    public static LocalUnionContent Resolve(User user,GameData data)
+    {
+        var state=user.LocalUnionRaid ?? throw new InvalidOperationException("local_union_not_selected");
+        var manager=data.LocalUnionManagers[state.ManagerTid];
+        int Config(string key) => data.LocalConfigGameRecords.TryGetValue(key,out var row) &&
+            int.TryParse(row.Value,out var value) && value>0 ? value : throw new InvalidOperationException("local_union_config_unresolved");
+        var tiers=new List<LocalUnionTier>();
+        foreach(var preset in data.LocalUnionPresets.Values.Where(x=>x.PresetGroupId==manager.MonsterPreset && x.DifficultyType==UnionRaidDifficultyType.Hard))
+        {
+            var wave=data.WaveIntercept001Table[preset.Wave];
+            // The catalog admission already requires an unambiguous boss target.
+            var targets=wave.TargetList!.Distinct().ToArray();
+            if(targets.Length!=1) throw new InvalidOperationException("local_union_target_unresolved");
+            var monster=data.MonsterTable[targets[0]];
+            var stat=data.MonsterStatEnhanceTable.Values.Single(x=>x.GroupId==monster.StatenhanceId && x.Lv==preset.MonsterStageLv);
+            var hp=checked((long)((decimal)stat.LevelHp*monster.HpRatio/10000));
+            if(hp<=0) throw new InvalidOperationException("local_union_hp_unresolved");
+            tiers.Add(new(preset.WaveOrder,preset.WaveChangeStep,hp,preset.IsTrial));
+        }
+        if(!tiers.Select(x=>x.Step).Distinct().Order().SequenceEqual(Enumerable.Range(1,5)) ||
+            tiers.GroupBy(x=>(x.Step,x.Level)).Any(x=>x.Count()!=1)) throw new InvalidOperationException("local_union_stages_invalid");
+        return new(tiers,Config("UnionRaidHardEnterCount"),Config("UnionRaidTeamCount"));
+    }
+}
