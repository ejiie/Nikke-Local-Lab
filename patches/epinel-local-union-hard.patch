+namespace EpinelPS.SelectedManager.Tests;
+
+public sealed class LocalUnionTests
+{
+    private static UnionRaidRankingTierRecord[] Tiers() =>
+        [new() { Id = 71, RankType = UnionRaidRankingTier.Beginner, TierNumber = 0 },
+         new() { Id = 72, RankType = UnionRaidRankingTier.Challenger, TierNumber = 1 }];
+
+    [Theory]
+    [InlineData(false)]
+    [InlineData(true)]
+    public void GuildWireRankResolvesInSourceTableWithoutChangingAdmission(bool simple)
+    {
+        var user = new User { LocalUnionRaid = new() { Level = 3, NormalCleared = true } };
+        user.Guild.guildId = LocalUnion.LocalGuildNumber;
+        var tiers = Tiers();
+        var index = tiers.ToDictionary(x => ((int)x.RankType, x.TierNumber));
+        Assert.False(index.ContainsKey((0, 0)));
+        var response = LocalUnion.Get(user, new() { IsSimple = simple }, [new() { Id = 17, Grade = 1 }], Profile(user), tiers);
+        var wire = ResGetGuild.Parser.ParseFrom(response.ToByteArray());
+        var tier = index[(wire.Guild.UnionRaidTier, wire.Guild.UnionRaidTierNumber)];
+        Assert.Equal(UnionRaidRankingTier.Beginner, tier.RankType);
+        Assert.Equal(3, wire.Guild.Grade);
+        Assert.True(user.LocalUnionRaid.NormalCleared);
+    }
+
+    [Fact]
+    public void UnrankedTierRequiresOneValidSourceRowAndUsesItsNumber()
+    {
+        Assert.Throws<InvalidOperationException>(() => LocalUnion.ResolveRankTier([]));
+        var row = Tiers()[0];
+        Assert.Throws<InvalidOperationException>(() => LocalUnion.ResolveRankTier([row, row]));
+        row.TierNumber = 7;
+        Assert.Equal(7, LocalUnion.ResolveRankTier([row]).TierNumber);
+        row.Id = 0;
+        Assert.Throws<InvalidOperationException>(() => LocalUnion.ResolveRankTier([row]));
+    }
+
+    [Fact]
+    public async Task ObservedLobbyStartupRouteReturnsAUnionRaidMessageInsteadOfEmptySuccess()
+    {
+        // The 152 client calls this inside its startup batch, including the guild prefix.
+        var registry = LobbyHandlerRegistry.Discover(typeof(LobbyMessage).Assembly);
+        Assert.IsType<GetLocalUnionRaid>(registry.CreateHandler("/guild/unionraid/get"));
+        Assert.IsType<GetLocalUnion>(registry.CreateHandler("/guild/get"));
+        var options = new DbContextOptionsBuilder<GameContext>().UseSqlite("Data Source=:memory:").Options;
+        using var services = new ServiceCollection().AddSingleton(new GameContext(options)).BuildServiceProvider();
+        var context = new DefaultHttpContext { RequestServices = services };
+        context.Request.Path = "/v1/guild/unionraid/get";
+        // A foreign guild avoids the operational JsonDb singleton and must still receive typed data.
+        context.Request.Body = new MemoryStream(new ReqGetUnionRaidData { Gsn = 999, IsSimple = true }.ToByteArray());
+        context.Response.Body = new MemoryStream();
+        await new LobbyRequestDispatcher(registry).DispatchAsync(context);
+        var response = ResGetUnionRaidData.Parser.ParseFrom(((MemoryStream)context.Response.Body).ToArray());
+        Assert.NotNull(response.Data);
+        Assert.Equal(UnionRaidState.Disable, response.Data.UnionRaidState);
+        Assert.Equal("application/octet-stream+protobuf", context.Response.ContentType);
+    }
+
+    [Fact]
+    public void MembershipAndNormalClearAreRequiredForHardOpening()
+    {
+        var user = new User();
+        var now = new DateTimeOffset(2026, 9, 17, 0, 0, 0, TimeSpan.Zero);
+        Assert.Null(LocalUnion.Get(user, new ReqGetGuild()).Guild);
+        Assert.Equal(UnionRaidState.Disable, LocalUnion.Raid(user, now).UnionRaidState);
+        user.Guild.guildId = LocalUnion.LocalGuildNumber;
+        user.LocalUnionRaid = new LocalUnionRaidState { ManagerTid = 101, NormalLastLevel = 10, SeasonNumber = 1 };
+        var guild = LocalUnion.Get(user, new ReqGetGuild(), [new GuildEmblemRecord { Id = 17, Grade = 1 }], Profile(user), Tiers());
+        Assert.Equal("NLL", guild.Guild.Name);
+        Assert.Equal(17, guild.Guild.Emblem);
+        Assert.Equal(UnionRaidState.Disable, LocalUnion.Raid(user, now).UnionRaidState);
+        user.LocalUnionRaid.NormalCleared = true;
+        user.LocalPersistenceBinding = new(){ AccountUid=Guid.NewGuid() };
+        var engine = new LocalUnionEngine(user,new(),new(Enumerable.Range(1,5).Select(step=>new LocalUnionTier(step,1,100,false)).ToList(),3,5),now);
+        var raid = LocalUnion.Raid(user, now,engine);
+        Assert.Equal(UnionRaidState.Open, raid.UnionRaidState);
+        Assert.Equal(1, raid.NormalClearDay);
+        Assert.Equal(5, raid.HardInfo.Count);
+        Assert.Equal(raid.PeriodData, LocalUnion.Raid(user, now.AddMinutes(1),engine).PeriodData);
+        user.LocalUnionRaid.Level = 2;
+        Assert.Equal(UnionRaidState.Disable, LocalUnion.Raid(user, now).UnionRaidState);
+    }
+
