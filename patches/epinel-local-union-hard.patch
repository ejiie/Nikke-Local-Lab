+using EpinelPS.Data;
+using EpinelPS.Database;
+using EpinelPS.Models;
+
+namespace EpinelPS.LobbyServer.Guild;
+
+public static class LocalUnionTeams
+{
+    public static void Save(User user,ReqSetTeam request)
+    {
+        var limit=LocalUnionContent.Resolve(user).Teams;
+        if(request.Type!=(int)TeamType.UnionRaid || request.Teams.Select(x=>x.TeamNumber).Distinct().Count()!=request.Teams.Count)
+            throw new InvalidOperationException("local_union_team_invalid");
+        var incoming=new Dictionary<int,List<LocalUnionTeamSlot>>();
+        foreach(var team in request.Teams)
+        {
+            if(team.TeamNumber<1||team.TeamNumber>limit||team.Slots.Count>5||team.Slots.Select(x=>x.Slot).Distinct().Count()!=team.Slots.Count)
+                throw new InvalidOperationException("local_union_team_invalid");
+            var slots=new List<LocalUnionTeamSlot>();
+            foreach(var slot in team.Slots.OrderBy(x=>x.Slot))
+            {
+                if(slot.Slot is <1 or >5 || slot.ValueType!=0)throw new InvalidOperationException("local_union_slot_invalid");
+                if(slot.Value==0)continue;
+                if(!user.Characters.Any(x=>x.Csn==slot.Value) || !user.LocalPersistenceBinding!.CharacterUidByCsn.TryGetValue(slot.Value,out var uid))
+                    throw new InvalidOperationException("local_union_character_unresolved");
+                slots.Add(new(){Slot=slot.Slot,Character=Guid.Parse(uid)});
+            }
+            if(slots.Select(x=>x.Character).Distinct().Count()!=slots.Count)throw new InvalidOperationException("local_union_team_duplicate_character");
+            incoming.Add(team.TeamNumber,slots);
+        }
+        var teams=LocalUnionRuntimeStore.Execute(user,state=>
+        {
+            if(!state.Members.TryGetValue(user.LocalPersistenceBinding!.AccountUid,out var member))state.Members[user.LocalPersistenceBinding.AccountUid]=member=new();
+            foreach(var team in incoming)member.Teams[team.Key]=team.Value;
+            return member.Teams;
+        });
+        Apply(user,teams);
+    }
+    public static void Restore(User user) => Apply(user,LocalUnionRuntimeStore.Execute(user,state=>
+        state.Members.GetValueOrDefault(user.LocalPersistenceBinding!.AccountUid)?.Teams ?? []));
+
+    public static void Apply(User user,Dictionary<int,List<LocalUnionTeamSlot>> teams)
+    {
+        var ids=user.LocalPersistenceBinding!.CharacterUidByCsn.ToDictionary(x=>Guid.Parse(x.Value),x=>x.Key);
+        var result=new NetUserTeamData{Type=(int)TeamType.UnionRaid,LastContentsTeamNumber=1};
+        foreach(var pair in teams.OrderBy(x=>x.Key))
+        {
+            var team=new NetTeamData{TeamNumber=pair.Key};
+            foreach(var slot in pair.Value)
+                if(ids.TryGetValue(slot.Character,out var csn))team.Slots.Add(new NetTeamSlot{Slot=slot.Slot,ValueType=0,Value=csn});
+            result.Teams.Add(team);
+        }
+        user.UserTeams[(int)TeamType.UnionRaid]=result;
+    }
+}
