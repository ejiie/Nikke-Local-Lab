+using EpinelPS.Models;
+using EpinelPS.Data;
+using Google.Protobuf.WellKnownTypes;
+
+namespace EpinelPS.LobbyServer.Guild;
+
+public static class LocalUnion
+{
+    public const int LocalGuildNumber = 1;
+
+    public static UnionRaidRankingTierRecord ResolveRankTier(IEnumerable<UnionRaidRankingTierRecord>? tiers = null)
+    {
+        // NLL has no settled season rank. Resolve the source's unranked tier, including its number.
+        // Protobuf's zero defaults mean Challenger/0, which is not a valid source-table key.
+        var tier = (tiers ?? GameData.Instance.LocalUnionRankingTiers.Values)
+            .SingleOrDefault(x => x.RankType == UnionRaidRankingTier.Beginner)
+            ?? throw new InvalidOperationException("local_union_ranking_tier_unresolved");
+        if (tier.Id <= 0 || tier.TierNumber < 0)
+            throw new InvalidOperationException("local_union_ranking_tier_invalid");
+        return tier;
+    }
+
+    public static ResGetGuild Get(User user, ReqGetGuild request, IEnumerable<GuildEmblemRecord>? emblems = null,
+        NetWholeUserData? profile = null, IEnumerable<UnionRaidRankingTierRecord>? tiers = null)
+    {
+        if (user.LocalUnionRaid is not { Level: >= 1 } state || user.Guild.guildId != LocalGuildNumber ||
+            (request.Gsn != 0 && request.Gsn != LocalGuildNumber))
+            return new ResGetGuild { IsSimple = request.IsSimple };
+        profile ??= LobbyHandler.CreateWholeUserDataFromDbUser(user);
+        if (profile.Usn != (long)user.ID || profile.Server <= 0)
+            throw new InvalidOperationException("local_union_member_profile_unresolved");
+        // Zero is not an emblem in the source table. Resolve a valid unlocked emblem
+        // from the current pack rather than emitting a missing table reference.
+        var emblem = (emblems ?? GameData.Instance.GuildEmblemRecords.Values)
+            .Where(x => x.Id > 0 && x.Grade <= state.Level).OrderBy(x => x.Grade).ThenBy(x => x.Id).FirstOrDefault()
+            ?? throw new InvalidOperationException("local_union_emblem_unresolved");
+        var tier = ResolveRankTier(tiers);
+        var response = new ResGetGuild
+        {
+            IsSimple = request.IsSimple,
+            Guild = new NetGuildData { Gsn = LocalGuildNumber, Name = state.Name, Grade = state.Level, Emblem = emblem.Id,
+                Locale = "ko", JoinLevel = 1, Desc = "Local Lab", Notice = "NLL",
+                UnionRaidTier = (int)tier.RankType, UnionRaidTierNumber = tier.TierNumber }
+        };
+        response.Members.Add(new NetGuildMemberData { Usn = profile.Usn, Nickname = profile.Nickname,
+            Lv = profile.Lv, Icon = profile.Icon, Frame = profile.Frame, Server = profile.Server,
+            IconPrism = profile.IconPrism, Type = 1, LastActionAt = profile.LastActionAt,
+            UserTitleId = profile.UserTitleId,
+            SendMailAt = Timestamp.FromDateTime(DateTime.UnixEpoch),
+            UserTitleDisplayData = new NetUserTitleDisplayData() });
+        return response;
+    }
+
+    public static NetUnionRaidData Raid(User user, DateTimeOffset now, LocalUnionEngine? engine = null)
+    {
+        if (user.LocalUnionRaid is not { Level: >= 3, NormalCleared: true, ManagerTid: > 0 } state ||
+            user.Guild.guildId != LocalGuildNumber)
+            return new NetUnionRaidData { UnionRaidState = UnionRaidState.Disable };
+        var periodStart = EpinelPS.LobbyServer.Soloraid.ClassicSoloRaidPeriodProvider.GetRaidDayStartUtc(now);
+        var result = new NetUnionRaidData
+        {
+            UnionRaidState = UnionRaidState.Open,
+            UnionRaidManagerTid = state.ManagerTid,
+            NormalClearDay = 1,
+            UnionRaidJoinData = new NetUnionRaidJoinData(),
+            CurrentStatus = new NetUnionRaidGuildInfo { Gsn = LocalGuildNumber, AchieveLevel = state.NormalLastLevel,
+                AchieveStep = 5, LeftHp = 0 },
+            UnionRaidRanking = new NetUnionRaidRankInfo { NormalClearDay = 1 },
+            PeriodData = new NetUnionRaidPeriodData { VisibleDate = periodStart.AddDays(-2).UtcDateTime.Ticks, StartDate = periodStart.AddDays(-1).UtcDateTime.Ticks,
+                EndDate = periodStart.AddDays(7).UtcDateTime.Ticks, DisableDate = periodStart.AddDays(8).UtcDateTime.Ticks, SettleDate = periodStart.AddDays(8).UtcDateTime.Ticks }
+        };
+        if(engine is null) return LocalUnionApi.Execute(user,(e,_)=>Raid(user,now,e));
+        result.HardInfo.AddRange(engine.Info());
+        result.UnionRaidJoinData=engine.Join();
+        result.UnionRaidRanking=engine.Rank();
+        result.TotalRank=1;
+        return result;
+    }
+}
+
+[GameRequest("/guild/get")]
+public sealed class GetLocalUnion : LobbyMessage
+{
+    protected override async Task HandleAsync()
+    {
+        var user = GetUser();
+        var request = await ReadData<ReqGetGuild>();
+        var response = LocalUnion.Get(user, request);
+        var member = response.Members.SingleOrDefault(x => x.Usn == (long)user.ID);
+        // Structural evidence only: do not log account identifiers or packet bodies.
+        EpinelPS.Utils.Logging.WriteLine($"[LocalUnion] simple={request.IsSimple} guildPresent={response.Guild is not null} memberCount={response.Members.Count} selfPresent={member is not null} serverPresent={member?.Server > 0} mailTimestampPresent={member?.SendMailAt is not null} titleDisplayPresent={member?.UserTitleDisplayData is not null}");
+        await WriteDataAsync(response);
+    }
+}
+
+[GameRequest("/guild/unionraid/get")]
+public sealed class GetLocalUnionRaid : LobbyMessage
+{
+    protected override async Task HandleAsync()
+    {
+        var request = await ReadData<ReqGetUnionRaidData>();
+        var data = request.Gsn is 0 or LocalUnion.LocalGuildNumber
+            ? LocalUnion.Raid(GetUser(), DateTimeOffset.UtcNow) : new NetUnionRaidData { UnionRaidState = UnionRaidState.Disable };
+        await WriteDataAsync(new ResGetUnionRaidData { Data = data });
+    }
+}
