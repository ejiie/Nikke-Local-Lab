+[GameRequest("/shootingrange/v2/get")]
+public sealed class LocalShootingRangeRanking:LocalUnionRequest<ReqGetShootingRangeRankingV2,ResGetShootingRangeRankingV2>
+{
+    public static ResGetShootingRangeRankingV2 Build(IEnumerable<ShootingRangeRecord> rows,NetWholeUserData profile)
+    {
+        var result=new ResGetShootingRangeRankingV2();
+        // GuildInfo indexes rankings by (element, battle length), without SpecActiveSpot.
+        // NLL supplies ordinary shooting-range buckets; fixed-spec practice is not a second ranking.
+        // Require one ordinary source row per display key instead of choosing an arbitrary ID.
+        var rankingRows=rows.GroupBy(x=>(x.ShootingRangeType,x.ShootingRangeBattleLengthType))
+            .Select(group=>group.Single(x=>!x.SpecActiveSpot)).OrderBy(x=>x.Id).ToArray();
+        // Empty ranking buckets still need a non-null self record for the guild view.
+        foreach(var row in rankingRows)
+            result.RankingList.Add(new NetShootingRangeRankingTotalData{ShootingRangeId=row.Id,
+                UserGuildRanking=new NetShootingRangeRankingData{User=profile.Clone()}});
+        return result;
+    }
+    protected override ResGetShootingRangeRankingV2 Process(User user,ReqGetShootingRangeRankingV2 request)=>
+        Build(GameData.Instance.LocalShootingRanges.Values,LobbyHandler.CreateWholeUserDataFromDbUser(user));
+}
