+using Microsoft.EntityFrameworkCore;
+using Microsoft.Extensions.DependencyInjection;
+using Xunit;
+
+namespace EpinelPS.SelectedManager.Tests;
+
+[CollectionDefinition("Local content singleton checks", DisableParallelization = true)]
+public sealed class LocalContentSingletonCollection { }
+
+[Collection("Local content singleton checks")]
+public sealed class LocalContentOpeningTests
+{
+    [Theory]
+    [InlineData(3, 1, true, 3, true)]
+    [InlineData(2, 1, true, 2, false)]
+    [InlineData(3, 0, true, 0, false)]
+    [InlineData(3, 2, true, 0, false)]
+    [InlineData(3, 1, false, 0, false)]
+    public async Task ContentOpeningWireUsesLocalMembershipLevel(int level, int guild, bool selected, int expected, bool opens)
+    {
+        var gameField = typeof(GameData).GetField("_instance", BindingFlags.Static | BindingFlags.NonPublic)!;
+        var priorGame = gameField.GetValue(null);
+        var coreProperty = typeof(User).Assembly.GetType("EpinelPS.Database.JsonDb")!.GetProperty("Instance")!;
+        var priorCore = coreProperty.GetValue(null);
+        try
+        {
+            var game = (GameData)RuntimeHelpers.GetUninitializedObject(typeof(GameData));
+            var rule = new ContentsOpenRecord { Id = ContentsOpen.UnionRaid, OpenCondition = [new() { OpenConditionType = ContentsOpenCondition.GuildLevel, OpenConditionValue = 3 }] };
+            typeof(GameData).GetField("ContentsOpenTable")!.SetValue(game, new Dictionary<ContentsOpen, ContentsOpenRecord> { [rule.Id] = rule });
+            var gacha = typeof(GameData).GetField("gachaTypes")!;
+            gacha.SetValue(game, Activator.CreateInstance(gacha.FieldType));
+            gameField.SetValue(null, game);
+            var user = new User { ID = 1, LocalUnionRaid = selected ? new() { Level = level, NormalCleared = true } : null };
+            user.Guild.guildId = guild;
+            user.GachaBannerMaxPulls[17] = 11;
+            coreProperty.SetValue(null, new CoreInfo { Users = [user] });
+            using var database = new GameContext(new DbContextOptionsBuilder<GameContext>().UseSqlite("Data Source=:memory:").Options);
+            using var services = new ServiceCollection().AddSingleton(database).BuildServiceProvider();
+            var context = new DefaultHttpContext { RequestServices = services };
+            context.Items["UserID"] = (ulong)1;
+            context.Request.Path = "/v1/user/getcontentsdata";
+            context.Request.Body = new MemoryStream(new ReqGetContentsOpenData().ToByteArray());
+            context.Response.Body = new MemoryStream();
+            await new LobbyRequestDispatcher(LobbyHandlerRegistry.Discover(typeof(LobbyMessage).Assembly)).DispatchAsync(context);
+            var wire = ResGetContentsOpenData.Parser.ParseFrom(((MemoryStream)context.Response.Body).ToArray());
+            Assert.Equal(expected, wire.GuildLevel);
+            Assert.Equal(opens, wire.GuildLevel >= rule.OpenCondition.Single().OpenConditionValue);
+            Assert.Equal(11, wire.MaxGachaCount);
+        }
+        finally { gameField.SetValue(null, priorGame); coreProperty.SetValue(null, priorCore); }
+    }
+
+    [Fact]
+    public void DatabaseValidationPreservesLevelsThrough1200AndIsIdempotent()
+    {
+        var type = typeof(User).Assembly.GetType("EpinelPS.Database.JsonDb")!;
+        var property = type.GetProperty("Instance")!;
+        var prior = property.GetValue(null);
+        try
+        {
+            var user = new User { SynchroDeviceLevel = 1200 };
+            foreach (var level in new[] { 999, 1000, 1001, 1199, 1200, 1201 }) user.Characters.Add(new() { Level = level });
+            property.SetValue(null, new CoreInfo { Users = [user] });
+            var validate = type.GetMethod("ValidateDb", BindingFlags.Static | BindingFlags.NonPublic)!;
+            for (var replay = 0; replay < 2; replay++)
+            {
+                validate.Invoke(null, null);
+                Assert.Equal(new[] { 999, 1000, 1001, 1199, 1200, 1200 }, user.Characters.Select(x => x.Level));
+                Assert.Equal(1200, user.SynchroDeviceLevel);
+            }
+        }
+        finally { property.SetValue(null, prior); }
+    }
+}
