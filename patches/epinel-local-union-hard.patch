+
+namespace EpinelPS.SelectedManager.Tests;
+
+public sealed class LocalUnionRuntimeTests
+{
+    static readonly DateTimeOffset Now=new(2026,9,17,1,0,0,TimeSpan.Zero);
+    static LocalUnionContent Content()=>new(Enumerable.Range(1,5).SelectMany(step=>new[]{new LocalUnionTier(step,1,100,false),new LocalUnionTier(step,2,200,step==5)}).ToArray(),3,5);
+    static User User()=>new(){LocalPersistenceBinding=new(){AccountUid=Guid.NewGuid()}};
+    static LocalUnionEngine Engine(User user,LocalUnionProgress state,DateTimeOffset? now=null)=>new(user,state,Content(),now??Now);
+    static void Teams(LocalUnionEngine engine)
+    {
+        for(var team=1;team<=5;team++)engine.Member.Teams[team]=Enumerable.Range(1,5).Select(slot=>new LocalUnionTeamSlot{Slot=slot,Character=Guid.NewGuid()}).ToList();
+    }
+    [Fact]
+    public void EntryAndResultReplaySurviveSerializationAndDoNotConsumeOrDamageTwice()
+    {
+        var user=User();var state=new LocalUnionProgress();var engine=Engine(user,state);Teams(engine);
+        Assert.Equal(UnionRaidJoinResult.Success,engine.Enter(1,1,1));
+        Assert.Equal(UnionRaidJoinResult.Success,engine.Enter(1,1,1));
+        Assert.Equal(1,engine.Join().HardPlayCount);
+        var first=engine.Damage(1,1,1,40,"packet-a");
+        var restored=JsonConvert.DeserializeObject<LocalUnionProgress>(JsonConvert.SerializeObject(state))!;
+        var next=Engine(user,restored);var replay=next.Damage(1,1,1,40,"packet-a");
+        Assert.Equal(first.Battle.BattleUid,replay.Battle.BattleUid);Assert.Single(restored.Battles);
+        Assert.Equal(60,next.Info()[0].LeftHp);Assert.Equal(1,next.Join().HardPlayCount);
+        Assert.Throws<InvalidOperationException>(()=>next.Damage(1,1,1,40,"unadmitted"));
+    }
+    [Fact]
+    public void SharedBossKillClampsOverkillAdvancesOnceAndUsesLeftHpOneof()
+    {
+        var state=new LocalUnionProgress();var first=Engine(User(),state);var second=Engine(User(),state);Teams(first);Teams(second);
+        first.Enter(1,1,1);second.Enter(1,1,1);
+        Assert.True(first.Damage(1,1,1,150,"first").Kill);
+        Assert.Equal(0,second.Damage(1,1,1,70,"late").Damage);
+        Assert.Equal(100,first.Rank().TotalDamage);
+        var info=NetUnionRaidGuildInfo.Parser.ParseFrom(first.Info()[0].ToByteArray());
+        Assert.True(info.HasLeftHp);Assert.False(info.HasLastBossTotalDamage);Assert.Equal(2,info.AchieveLevel);Assert.Equal(200,info.LeftHp);
+    }
+    [Fact]
+    public void TrialAccumulatesScoreWithoutKillAndPracticeDoesNotConsumeEntriesOrChangeProgress()
+    {
+        var user=User();var state=new LocalUnionProgress();var engine=Engine(user,state);Teams(engine);
+        engine.Enter(1,5,1);engine.Damage(1,5,1,100,"kill");engine.Enter(2,5,2);
+        var score=engine.Damage(2,5,2,500,"score");Assert.False(score.Kill);
+        Assert.True(engine.Info()[4].HasLastBossTotalDamage);Assert.Equal(500,engine.Info()[4].LastBossTotalDamage);
+        var before=JsonConvert.SerializeObject(state.Bosses);engine.Enter(2,5,0,true);engine.Damage(2,5,2,800,"practice",true);
+        Assert.Equal(before,JsonConvert.SerializeObject(state.Bosses));Assert.Equal(2,engine.Join().HardPlayCount);Assert.Equal(600,engine.Rank().TotalDamage);
+    }
+    [Fact]
+    public void DailyLimitAndUsedCharactersResetAtSeoulFiveWithoutResettingBossHp()
+    {
+        var user=User();var state=new LocalUnionProgress();var engine=Engine(user,state);Teams(engine);
+        for(var t=1;t<=3;t++){Assert.Equal(UnionRaidJoinResult.Success,engine.Enter(1,1,t));engine.Damage(1,1,t,1,$"result{t}");}
+        Assert.Equal(UnionRaidJoinResult.Banned,engine.Enter(1,1,4));
+        var next=Engine(user,state,new DateTimeOffset(2026,9,17,20,0,0,TimeSpan.Zero));
+        Assert.Equal(0,next.Join().HardPlayCount);Assert.Empty(next.Member.UsedCharacters);Assert.Equal(97,next.Info()[0].LeftHp);
+        Assert.Equal(UnionRaidJoinResult.Success,next.Enter(1,1,1));
+    }
+    [Fact]
+    public void LogicalCharacterTeamsRebindToNewRuntimeCsn()
+    {
+        var user=User();var uid=Guid.NewGuid();user.LocalPersistenceBinding!.CharacterUidByCsn[900]=uid.ToString();
+        LocalUnionTeams.Apply(user,new(){[2]=[new(){Slot=3,Character=uid}]});
+        Assert.Equal(900,user.UserTeams[(int)TeamType.UnionRaid].Teams.Single().Slots.Single().Value);
+        user.LocalPersistenceBinding.CharacterUidByCsn.Clear();user.LocalPersistenceBinding.CharacterUidByCsn[1200]=uid.ToString();
+        LocalUnionTeams.Apply(user,new(){[2]=[new(){Slot=3,Character=uid}]});
+        Assert.Equal(1200,user.UserTeams[(int)TeamType.UnionRaid].Teams.Single().Slots.Single().Value);
+    }
+    [Fact]
+    public void ShootingRangeWireSupportsClientDisplayDictionaryAcrossBothSourceVariants()
+    {
+        var rows=(from element in Enum.GetValues<ShootingRangeType>()
+                  from length in Enum.GetValues<ShootingRangeBattleLength>()
+                  from fixedSpec in new[]{true,false}
+                  select new ShootingRangeRecord{Id=1+(int)element*3+(int)length+(fixedSpec?0:100),
+                      ShootingRangeType=element,ShootingRangeBattleLengthType=length,SpecActiveSpot=fixedSpec}).Reverse().ToArray();
+        var source=rows.ToDictionary(x=>x.Id);
+        // Sending both variants reproduced GuildInfo's duplicate-key exception even though protobuf succeeded.
+        Assert.Throws<ArgumentException>(()=>rows.ToDictionary(x=>(x.ShootingRangeType,x.ShootingRangeBattleLengthType)));
+        var wire=ResGetShootingRangeRankingV2.Parser.ParseFrom(LocalShootingRangeRanking.Build(rows,new(){Usn=1,Server=1001}).ToByteArray());
+        var display=wire.RankingList.ToDictionary(x=>{
+            var row=source[x.ShootingRangeId];return (row.ShootingRangeType,row.ShootingRangeBattleLengthType);
+        });
+        Assert.Equal(15,display.Count);
+        Assert.Equal(rows.Where(x=>!x.SpecActiveSpot).Select(x=>x.Id).Order(),wire.RankingList.Select(x=>x.ShootingRangeId));
+        foreach(var row in rows)Assert.True(display.ContainsKey((row.ShootingRangeType,row.ShootingRangeBattleLengthType)));
+        Assert.All(wire.RankingList,x=>{Assert.False(source[x.ShootingRangeId].SpecActiveSpot);Assert.Equal(1L,x.UserGuildRanking.User.Usn);});
+        var reordered=LocalShootingRangeRanking.Build(rows.Reverse(),new(){Usn=1,Server=1001});
+        Assert.Equal(wire.ToByteArray(),reordered.ToByteArray());
+    }
+    [Theory]
+    [InlineData(false)]
+    [InlineData(true)]
+    public void ShootingRangeRejectsMissingOrAmbiguousOrdinarySourceRow(bool duplicate)
+    {
+        ShootingRangeRecord[] rows=duplicate
+            ? [new(){Id=17,SpecActiveSpot=false},new(){Id=27,SpecActiveSpot=false}]
+            : [new(){Id=17,SpecActiveSpot=true}];
+        Assert.Throws<InvalidOperationException>(()=>LocalShootingRangeRanking.Build(rows,new()));
+    }
+    [Fact]
+    public void AllUnionRaidProtoPathsAreRegisteredIncludingTheSourcePracticeTypo()
+    {
+        var registry=LobbyHandlerRegistry.Discover(typeof(LobbyMessage).Assembly);
+        string[] suffixes=["get","getjoindata","getstepinfo","get/nowplaying","hard/getstepinfo","hard/get/nowplaying","enter","hard/enter","setdamage","hard/setdamage",
+            "practice/enter","hard/practice/enter","pratice/setdamage","pratice/setdamage/hard","ranking/world","log/whole","log/user","log/step","memberlog","bosspopup/get","bosspopup/set"];
+        foreach(var suffix in suffixes)Assert.NotNull(registry.CreateHandler("/guild/unionraid/"+suffix));
+        Assert.IsType<LocalShootingRangeRanking>(registry.CreateHandler("/shootingrange/v2/get"));
+        Assert.True(registry.GetRegistration("/guild/unionraid/hard/enter").SerializeByAccount);
+        Assert.True(registry.GetRegistration("/team/setteam").SerializeByAccount);
+    }
