+using EpinelPS.Models;
+using EpinelPS.LobbyServer.Soloraid;
+
+namespace EpinelPS.LobbyServer.Guild;
+
+// The caller holds the shared guild transaction; no mutation is acknowledged before commit.
+public sealed class LocalUnionEngine(User user, LocalUnionProgress state, LocalUnionContent content, DateTimeOffset now)
+{
+    public Guid Account => user.LocalPersistenceBinding?.AccountUid ?? throw new InvalidOperationException("local_union_identity_missing");
+    public LocalUnionMemberProgress Member
+    {
+        get
+        {
+            if(!state.Members.TryGetValue(Account,out var member)) state.Members[Account]=member=new();
+            var day=ClassicSoloRaidPeriodProvider.GetRaidDayStartUtc(now).ToString("O");
+            if(member.RaidDay!=day)
+            {
+                member.RaidDay=day; member.HardPlayCount=0;member.UsedCharacters.Clear();member.Active=null;member.Practice=null;
+            }
+            return member;
+        }
+    }
+    public NetUnionRaidJoinData Join()
+    {
+        var member=Member;
+        var result=new NetUnionRaidJoinData{HardPlayCount=member.HardPlayCount};
+        foreach(var pair in user.LocalPersistenceBinding!.CharacterUidByCsn)
+            if(Guid.TryParse(pair.Value,out var uid)&&member.UsedCharacters.Contains(uid))result.CsnList.Add(pair.Key);
+        return result;
+    }
+    public LocalUnionBossProgress Boss(int step)
+    {
+        content.Tier(step,1);
+        if(!state.Bosses.TryGetValue(step,out var boss))state.Bosses[step]=boss=new();
+        return boss;
+    }
+    public List<NetUnionRaidGuildInfo> Info() => Enumerable.Range(1,5).Select(step=>
+    {
+        var boss=Boss(step);var tier=content.Tier(step,boss.Level);
+        var info=new NetUnionRaidGuildInfo{Gsn=LocalUnion.LocalGuildNumber,AchieveStep=step,AchieveLevel=boss.Level};
+        if(tier.Trial) info.LastBossTotalDamage=boss.Damage; else info.LeftHp=Math.Max(0,tier.Hp-boss.Damage);
+        return info;
+    }).ToList();
+    public UnionRaidJoinResult Enter(int level,int step,int team,bool practice=false)
+    {
+        var member=Member;var tier=content.Tier(step,level);
+        if(practice)
+        {
+            if(member.Practice is not { } prior || prior.Level!=level || prior.Step!=step)
+                member.Practice=new(){Level=level,Step=step,StartedAt=now.UtcTicks};
+            return UnionRaidJoinResult.Success;
+        }
+        var boss=Boss(step);
+        if(boss.Level!=level || !tier.Trial && boss.Damage>=tier.Hp)return UnionRaidJoinResult.FailureAlreadyKilled;
+        if(team<1||team>content.Teams||!member.Teams.TryGetValue(team,out var characters)||characters.Count is <1 or >5 ||
+            characters.Select(x=>x.Character).Distinct().Count()!=characters.Count) return UnionRaidJoinResult.Banned;
+        if(member.Active is {} active && active.Level==level && active.Step==step && active.Team==team &&
+            active.Characters.Select(x=>(x.Slot,x.Character)).SequenceEqual(characters.Select(x=>(x.Slot,x.Character))))
+            return UnionRaidJoinResult.Success;
+        if(member.HardPlayCount>=content.Entries || characters.Any(x=>member.UsedCharacters.Contains(x.Character)))return UnionRaidJoinResult.Banned;
+        member.HardPlayCount++;
+        member.UsedCharacters.AddRange(characters.Select(x=>x.Character));
+        member.Active=new(){Level=level,Step=step,Team=team,StartedAt=now.UtcTicks,Characters=characters.Select(x=>new LocalUnionTeamSlot{Slot=x.Slot,Character=x.Character}).ToList()};
+        return UnionRaidJoinResult.Success;
+    }
+    public LocalUnionBattleRecord Damage(int level,int step,int team,long damage,string hash,bool practice=false,NetAntiCheatBattleData? report=null)
+    {
+        if(damage<0 || string.IsNullOrEmpty(hash))throw new InvalidOperationException("local_union_result_invalid");
+        var previous=state.Battles.SingleOrDefault(x=>x.Account==Account && x.RequestHash==hash && x.Practice==practice);
+        if(previous is not null)return previous;
+        var member=Member;var active=practice?member.Practice:member.Active;
+        if(active is null || active.Level!=level || active.Step!=step || !practice && active.Team!=team)
+            throw new InvalidOperationException("local_union_result_without_entry");
+        if(practice)
+        {
+            if(!member.Teams.TryGetValue(team,out var characters) || characters.Count is <1 or >5)
+                throw new InvalidOperationException("local_union_team_invalid");
+            active.Team=team;active.Characters=characters.Select(x=>new LocalUnionTeamSlot{Slot=x.Slot,Character=x.Character}).ToList();
+        }
+        foreach(var slot in active.Characters)
+        {
+            var csn=user.LocalPersistenceBinding!.CharacterUidByCsn.FirstOrDefault(x=>x.Value==slot.Character.ToString()).Key;
+            var character=user.Characters.SingleOrDefault(x=>x.Csn==csn);
+            var observed=report?.Characters.SingleOrDefault(x=>x.Csn==csn)?.CharacterSpec;
+            slot.Level=observed?.Level ?? character?.Level ?? 0;
+            slot.Combat=checked((int)Math.Clamp(observed?.Combat ?? 0,0,int.MaxValue));
+        }
+        var tier=content.Tier(step,level);var boss=Boss(step);
+        var left=tier.Trial?0:Math.Max(0,tier.Hp-(practice?0:boss.Level==level?boss.Damage:tier.Hp));
+        var applied=tier.Trial?damage:Math.Min(damage,left);
+        var kill=!tier.Trial && left>0 && applied==left;
+        if(!practice && boss.Level==level)
+        {
+            boss.Damage=checked(boss.Damage+applied);
+            if(kill && content.Tiers.Any(x=>x.Step==step && x.Level==level+1)){boss.Level++;boss.Damage=0;}
+        }
+        var result=new LocalUnionBattleRecord{Account=Account,Battle=active,RequestHash=hash,Damage=applied,
+            LeftHp=tier.Trial?0:left-applied,At=now.UtcTicks,Kill=kill,Practice=practice};
+        state.Battles.Add(result);
+        if(practice)member.Practice=null;else member.Active=null;
+        return result;
+    }
+    public bool Playing(int level,int step) => state.Members.Where(x=>x.Key!=Account).Any(x=>
+        x.Value.Active is {} b && b.Level==level && b.Step==step && x.Value.RaidDay==Member.RaidDay);
+    public NetUnionRaidRankInfo Rank() => new(){Ranking=1,NormalClearDay=1,
+        TotalDamage=state.Battles.Where(x=>!x.Practice).Aggregate(0L,(total,x)=>checked(total+x.Damage))};
+}
