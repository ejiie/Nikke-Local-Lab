+using EpinelPS.Models;
+using Newtonsoft.Json;
+using Npgsql;
+using NpgsqlTypes;
+
+namespace EpinelPS.Database;
+
+public static class LocalUnionRuntimeStore
+{
+    public static T Execute<T>(User user, Func<LocalUnionProgress,T> action)
+    {
+        var selected = user.LocalUnionRaid ?? throw new InvalidOperationException("local_union_not_selected");
+        var account = user.LocalPersistenceBinding?.AccountUid ?? throw new InvalidOperationException("local_union_identity_missing");
+        if (account == Guid.Empty || selected.SeasonNumber <= 0 || string.IsNullOrWhiteSpace(selected.ConnectionEnvironmentVariable))
+            throw new InvalidOperationException("local_union_binding_missing");
+        var connectionString = Environment.GetEnvironmentVariable(selected.ConnectionEnvironmentVariable);
+        if (string.IsNullOrWhiteSpace(connectionString)) throw new InvalidOperationException("local_union_store_unavailable");
+        using var connection = new NpgsqlConnection(connectionString);
+        connection.Open();
+        using var transaction = connection.BeginTransaction();
+        // Serialize all accounts of the shared local union and reject stale selections.
+        short unionId;
+        using (var admission = new NpgsqlCommand("""
+            SELECT u.selected_season_number,u.local_union_id FROM lab_private_server.local_union u
+            JOIN lab_private_server.local_union_member m USING(local_union_id)
+            JOIN lab_profile.local_account a USING(local_account_id)
+            WHERE a.local_account_uid=@account FOR UPDATE OF u
+            """, connection, transaction))
+        {
+            admission.Parameters.AddWithValue("account",account);
+            using var reader = admission.ExecuteReader();
+            if (!reader.Read() || reader.IsDBNull(0) || reader.GetInt32(0) != selected.SeasonNumber)
+                throw new InvalidOperationException("local_union_selection_changed");
+            unionId = reader.GetInt16(1);
+        }
+        using var read = new NpgsqlCommand("SELECT payload::text FROM lab_private_server.local_union_raid_runtime WHERE local_union_id=@union AND season_number=@season",connection,transaction);
+        read.Parameters.AddWithValue("union",unionId);
+        read.Parameters.AddWithValue("season",selected.SeasonNumber);
+        var json=read.ExecuteScalar() as string;
