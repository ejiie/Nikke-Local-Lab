+using EpinelPS;
+using EpinelPS.Database;
+using EpinelPS.LobbyServer.Soloraid;
+using EpinelPS.Models;
+using Newtonsoft.Json;
+using Xunit;
+
+namespace EpinelPS.SelectedManager.Tests;
+
+public sealed class RuntimePreferencesMutationTests
+{
+    [Fact]
+    public void UnplayedTeamsEmptySlotsAndLastSelectionDoNotChangeBattleState()
+    {
+        var user = ClassicRouteTestFixture.ActiveUser();
+        var history = JsonConvert.SerializeObject(user.SoloRaidData);
+        var request = new ReqSetTeam { Type = (int)EpinelPS.Data.TeamType.SoloRaid };
+        foreach (var number in Enumerable.Range(1,5))
+        {
+            var team = new NetTeamData { TeamNumber = number };
+            team.Slots.Add(new NetTeamSlot { Slot = 1, Value = 111 });
+            team.Slots.Add(new NetTeamSlot { Slot = 2, Value = 0 });
+            request.Teams.Add(team);
+        }
+        RuntimePreferencesMutation.SetSoloRaidTeam(user, request);
+        request.Teams[0].Slots.Clear();
+        Assert.Equal(2, user.UserTeams[request.Type].Teams[0].Slots.Count);
+        var clear = new ReqSetTeam { Type = request.Type };
+        clear.Teams.Add(new NetTeamData { TeamNumber = 3 });
+        RuntimePreferencesMutation.SetSoloRaidTeam(user, clear);
+        Assert.Empty(user.UserTeams[request.Type].Teams.Single(team => team.TeamNumber == 3).Slots);
+        Assert.Equal(5, user.UserTeams[request.Type].Teams.Count);
+        Assert.Equal(3, user.UserTeams[request.Type].LastContentsTeamNumber);
+        RuntimePreferencesMutation.SetSoloRaidTeam(user, new ReqSetTeam { Type = request.Type, ContentsId = 1 });
+        Assert.Equal(2, user.UserTeams[request.Type].LastContentsTeamNumber);
+        Assert.Equal(history, JsonConvert.SerializeObject(user.SoloRaidData));
+    }
+
+    [Fact]
+    public async Task PreferenceBattleAndOtherWritersCannotReplaceEachOthersCommittedHistory()
+    {
+        var root = Path.Combine(Path.GetTempPath(), "nll-preference-test-" + Guid.NewGuid().ToString("N"));
+        var path = Path.Combine(root, "db.json");
+        var core = new CoreInfo { Users = [ClassicRouteTestFixture.ActiveUser()] };
+        var coordinator = new ClassicSoloRaidPersistenceCoordinator(() => core, next => core = next, path);
+        try
+        {
+            var tasks = Enumerable.Range(1,4).Select(number => Task.Run(() => coordinator.Execute(working =>
+            {
+                var response = new ResSetSoloRaidTrialDamage();
+                Assert.True(SoloRaidHelper.SetDamageTrial(working.Users.Single(), ref response,
+                    ClassicRouteTestFixture.DamageRequest(number), ClassicRouteTestFixture.TargetManager));
+                return CoordinatedMutation<bool>.Commit(true);
+            }))).ToList();
+            tasks.Add(Task.Run(() => coordinator.Execute(working =>
+            {
+                working.Users.Single().TitleId = 77;
+                return CoordinatedMutation<bool>.Commit(true);
+            })));
+            await Task.WhenAll(tasks);
+            coordinator.SaveCurrent();
+            var restarted = JsonConvert.DeserializeObject<CoreInfo>(File.ReadAllText(path))!;
+            Assert.Equal(4, restarted.Users.Single().SoloRaidData[ClassicRouteTestFixture.TargetManager].BattleHistory.Count);
+            Assert.Equal(77, restarted.Users.Single().TitleId);
+            Assert.Equal(JsonConvert.SerializeObject(core), JsonConvert.SerializeObject(restarted));
+        }
+        finally
+        {
+            if (File.Exists(path)) File.Delete(path);
+            if (Directory.Exists(root)) Directory.Delete(root);
+        }
+    }
+
+    [Fact]
+    public void DiskFailureDoesNotPublishAcceptedPreference()
+    {
+        var root = Path.Combine(Path.GetTempPath(), "nll-preference-test-" + Guid.NewGuid().ToString("N"));
+        Directory.CreateDirectory(root);
+        var blocked = Path.Combine(root, "not-a-directory");
+        File.WriteAllText(blocked, "synthetic");
+        var core = new CoreInfo { Users = [ClassicRouteTestFixture.ActiveUser()] };
+        var before = JsonConvert.SerializeObject(core);
+        var coordinator = new ClassicSoloRaidPersistenceCoordinator(() => core, next => core = next, Path.Combine(blocked, "db.json"));
+        try
+        {
+            Assert.ThrowsAny<IOException>(() => coordinator.Execute(working =>
+            {
+                working.Users.Single().TitleId = 77;
+                return CoordinatedMutation<bool>.Commit(true);
+            }));
+            Assert.Equal(before, JsonConvert.SerializeObject(core));
+        }
+        finally { File.Delete(blocked); Directory.Delete(root); }
+    }
+}
