@@ -0,0 +1,79 @@
+using Newtonsoft.Json;
+
+namespace EpinelPS.Models;
+
+// Local-only state, never a protocol extension. My Records projects only Log.ToNet().
+public sealed class ClassicSoloRaidBattleReceipt
+{
+    public Guid BattleUid { get; set; }
+    public Guid RunUid { get; set; }
+    public int Ordinal { get; set; }
+    public long Sequence { get; set; }
+    public DateTimeOffset? AcceptedAtUtc { get; set; }
+    public string Origin { get; set; } = "accepted_battle";
+    public SoloRaidType Type { get; set; }
+    public int RaidLevel { get; set; }
+    public long BossHp { get; set; }
+    public long RunDamageAfter { get; set; }
+    public SoloRaidLogData Log { get; set; } = new();
+
+    public static void Append(SoloRaidInfo raid, SoloRaidLevelData level, SoloRaidLogData log)
+    {
+        if (level.LocalRunUid == Guid.Empty) level.LocalRunUid = Guid.NewGuid();
+        var snapshot = JsonConvert.DeserializeObject<SoloRaidLogData>(JsonConvert.SerializeObject(log))
+            ?? throw new InvalidDataException("classic_history_snapshot_invalid");
+        raid.BattleHistory.Add(new ClassicSoloRaidBattleReceipt
+        {
+            BattleUid = Guid.NewGuid(), RunUid = level.LocalRunUid,
+            Ordinal = level.RaidJoinCount,
+            Sequence = checked((raid.BattleHistory.LastOrDefault()?.Sequence ?? 0) + 1),
+            AcceptedAtUtc = DateTimeOffset.UtcNow, Type = level.Type,
+            RaidLevel = level.RaidLevel, BossHp = level.Hp, RunDamageAfter = level.TotalDamage, Log = snapshot,
+        });
+        raid.BattleRunStatus.TryAdd(level.LocalRunUid, "open");
+        if (!level.IsOpen) Close(raid, level, "completed");
+    }
+
+    public static void Close(SoloRaidInfo raid, SoloRaidLevelData level, string status)
+    {
+        if (level.LocalRunUid != Guid.Empty && raid.BattleHistory.Any(entry => entry.RunUid == level.LocalRunUid))
+            raid.BattleRunStatus[level.LocalRunUid] = status;
+    }
+
+    // Only records still present in a legacy snapshot can be retained. Their
+    // original receipt time and inter-run chronology are unknown, never invented.
+    public static void RetainLegacySnapshots(SoloRaidInfo raid)
+    {
+        foreach (var level in raid.SoloRaidLevels.Where(level => level.RaidLevel == 8 &&
+            level.Type is SoloRaidType.Trial or SoloRaidType.Practice).OrderBy(level => level.IsOpen))
+        {
+            if (level.LocalRunUid != Guid.Empty || level.Logs.Count == 0) continue;
+            level.LocalRunUid = Guid.NewGuid();
+            long cumulativeDamage = 0;
+            for (var index = 0; index < level.Logs.Count; index++)
+            {
+                var snapshot = JsonConvert.DeserializeObject<SoloRaidLogData>(JsonConvert.SerializeObject(level.Logs[index]))
+                    ?? throw new InvalidDataException("classic_history_snapshot_invalid");
+                cumulativeDamage = checked(cumulativeDamage + snapshot.Damage);
+                raid.BattleHistory.Add(new ClassicSoloRaidBattleReceipt
+                {
+                    BattleUid = Guid.NewGuid(), RunUid = level.LocalRunUid, Ordinal = index + 1,
+                    Sequence = checked((raid.BattleHistory.LastOrDefault()?.Sequence ?? 0) + 1),
+                    AcceptedAtUtc = null, Origin = "legacy_snapshot", Type = level.Type,
+                    RaidLevel = level.RaidLevel, BossHp = level.Hp, RunDamageAfter = cumulativeDamage, Log = snapshot,
+                });
+            }
+            raid.BattleRunStatus[level.LocalRunUid] = level.IsOpen ? "open" : "completed";
+        }
+    }
+
+    public SoloRaidLevelData ReplayLevel(SoloRaidInfo raid) => new()
+    {
+        LocalRunUid = RunUid, RaidLevel = RaidLevel, Type = Type, Hp = BossHp,
+        RaidJoinCount = Ordinal, TotalDamage = RunDamageAfter, IsOpen = Ordinal < 5,
+        IsClear = Ordinal == 5, Status = Ordinal == 5 ? SoloRaidStatus.Kill : SoloRaidStatus.Alive,
+        Logs = raid.BattleHistory.Where(entry => entry.RunUid == RunUid && entry.Ordinal <= Ordinal)
+            .OrderBy(entry => entry.Ordinal).Select(entry => JsonConvert.DeserializeObject<SoloRaidLogData>(
+                JsonConvert.SerializeObject(entry.Log))!).ToList(),
+    };
+}
