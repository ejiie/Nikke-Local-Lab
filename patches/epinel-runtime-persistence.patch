diff --git a/EpinelPS/Database/RuntimePreferencesMutation.cs b/EpinelPS/Database/RuntimePreferencesMutation.cs
new file mode 100644
--- /dev/null
+++ b/EpinelPS/Database/RuntimePreferencesMutation.cs
@@ -0,0 +1,32 @@
+using EpinelPS.Models;
+
+namespace EpinelPS.Database;
+
+public static class RuntimePreferencesMutation
+{
+    internal static void Update(ulong accountId, Action<User> mutation) =>
+        JsonDb.ClassicSoloRaidPersistence.Execute(core =>
+        {
+            var user = core.Users.Single(candidate => candidate.ID == accountId);
+            mutation(user);
+            return CoordinatedMutation<bool>.Commit(true);
+        });
+
+    public static void SetSoloRaidTeam(User user, ReqSetTeam request)
+    {
+        var type = (int)EpinelPS.Data.TeamType.SoloRaid;
+        if (request.Type != type) throw new InvalidOperationException("local_solo_raid_team_type_invalid");
+        var selected = request.Teams.Count == 0 ? checked(request.ContentsId + 1) : request.Teams.Max(team => team.TeamNumber);
+        if (selected is < 1 or > 5 || request.Teams.Any(team => team.TeamNumber is < 1 or > 5))
+            throw new InvalidOperationException("local_solo_raid_team_number_invalid");
+        if (!user.UserTeams.TryGetValue(type, out var teams))
+            user.UserTeams[type] = teams = new NetUserTeamData { Type = type };
+        teams.LastContentsTeamNumber = selected;
+        foreach (var incoming in request.Teams)
+        {
+            var index = teams.Teams.ToList().FindIndex(team => team.TeamNumber == incoming.TeamNumber);
+            if (index < 0) teams.Teams.Add(incoming.Clone());
+            else teams.Teams[index] = incoming.Clone();
+        }
+    }
+}
