diff --git a/tests/EpinelPS.SelectedManager.Tests/ClassicBattleHistoryTests.cs b/tests/EpinelPS.SelectedManager.Tests/ClassicBattleHistoryTests.cs
new file mode 100644
--- /dev/null
+++ b/tests/EpinelPS.SelectedManager.Tests/ClassicBattleHistoryTests.cs
@@ -0,0 +1,145 @@
+using EpinelPS;
+using EpinelPS.Database;
+using EpinelPS.LobbyServer.Soloraid;
+using EpinelPS.Models;
+using Newtonsoft.Json;
+using Xunit;
+
+namespace EpinelPS.SelectedManager.Tests;
+
+public sealed class ClassicBattleHistoryTests
+{
+    [Fact]
+    public void LegacyKnownDecksRemainVisibleAndQuitDoesNotRewriteBattleSnapshots()
+    {
+        var user = ClassicRouteTestFixture.ActiveUser();
+        var raid = user.SoloRaidData[ClassicRouteTestFixture.TargetManager];
+        var legacy = NewRun();
+        legacy.IsOpen = false;
+        legacy.IsClear = true;
+        legacy.Status = SoloRaidStatus.Kill;
+        legacy.RaidJoinCount = 5;
+        legacy.TotalDamage = 150;
+        legacy.Logs = new long[] { 25, 35, 55, 15, 20 }.Select(value => new SoloRaidLogData { Damage = value }).ToList();
+        raid.SoloRaidLevels.Add(legacy);
+        var response = new ResSetSoloRaidTrialDamage();
+        Assert.True(SoloRaidHelper.SetDamageTrial(user, ref response,
+            ClassicRouteTestFixture.DamageRequest(61), ClassicRouteTestFixture.TargetManager));
+        Assert.Equal(6, raid.BattleHistory.Count);
+        Assert.All(raid.BattleHistory.Take(5), entry =>
+        {
+            Assert.Equal("legacy_snapshot", entry.Origin);
+            Assert.Null(entry.AcceptedAtUtc);
+        });
+        Assert.NotNull(raid.BattleHistory.Last().AcceptedAtUtc);
+        var immutable = JsonConvert.SerializeObject(raid.BattleHistory);
+        Assert.True(SoloRaidHelper.CloseSoloRaid(user, ClassicRouteTestFixture.TargetManager, 8, SoloRaidType.Trial));
+        Assert.Equal(immutable, JsonConvert.SerializeObject(raid.BattleHistory));
+        var logs = new ResGetSoloRaidLogs();
+        SoloRaidHelper.GetSoloRaidLog(user, ref logs, ClassicRouteTestFixture.TargetManager, 8);
+        Assert.Equal(new long[] { 61, 20, 15, 55, 35, 25 }, logs.Logs.Select(log => log.Damage));
+    }
+
+    [Fact]
+    public void EveryDeckSurvivesLowerCompletionQuitAndReloadIndependentlyOfBest()
+    {
+        var user = ClassicRouteTestFixture.ActiveUser();
+        long[][] runs = [[20, 30, 50, 10, 15], [25, 35, 55, 15, 20], [15, 25, 45, 5, 10], [61]];
+        foreach (var damages in runs)
+        {
+            var raid = user.SoloRaidData[ClassicRouteTestFixture.TargetManager];
+            if (!raid.SoloRaidLevels.Any(level => level.IsOpen))
+                raid.SoloRaidLevels.Add(NewRun());
+            foreach (var damage in damages)
+            {
+                var response = new ResSetSoloRaidTrialDamage();
+                Assert.True(SoloRaidHelper.SetDamageTrial(user, ref response,
+                    ClassicRouteTestFixture.DamageRequest(damage), ClassicRouteTestFixture.TargetManager));
+            }
+        }
+        Assert.True(SoloRaidHelper.CloseSoloRaid(user, ClassicRouteTestFixture.TargetManager, 8, SoloRaidType.Trial));
+        user = JsonConvert.DeserializeObject<User>(JsonConvert.SerializeObject(user))!;
+        var state = user.SoloRaidData[ClassicRouteTestFixture.TargetManager];
+        Assert.Equal(150, SoloRaidHelper.GetBestCompletedTrialLevel(state, 8)!.TotalDamage);
+        Assert.Equal(16, state.BattleHistory.Count);
+        Assert.Equal(16, state.BattleHistory.Select(entry => entry.BattleUid).Distinct().Count());
+        Assert.Equal(4, state.BattleHistory.Select(entry => entry.RunUid).Distinct().Count());
+        Assert.Equal("abandoned", state.BattleRunStatus[state.BattleHistory.Last().RunUid]);
+        var logs = new ResGetSoloRaidLogs();
+        SoloRaidHelper.GetSoloRaidLog(user, ref logs, ClassicRouteTestFixture.TargetManager, 8);
+        Assert.Equal(runs.SelectMany(run => run).Reverse(), logs.Logs.Select(log => log.Damage));
+    }
+
+    [Fact]
+    public void DuplicateReceiptDoesNotAppendButSameRequestInNewRunDoes()
+    {
+        var user = ClassicRouteTestFixture.ActiveUser();
+        var request = ClassicRouteTestFixture.DamageRequest(61);
+        var response = new ResSetSoloRaidTrialDamage();
+        Assert.True(SoloRaidHelper.SetDamageTrial(user, ref response, request, ClassicRouteTestFixture.TargetManager));
+        var before = JsonConvert.SerializeObject(user);
+        Assert.True(SoloRaidHelper.SetDamageTrial(user, ref response, request, ClassicRouteTestFixture.TargetManager));
+        Assert.Equal(before, JsonConvert.SerializeObject(user));
+        Assert.True(SoloRaidHelper.CloseSoloRaid(user, ClassicRouteTestFixture.TargetManager, 8, SoloRaidType.Trial));
+        user.SoloRaidData[ClassicRouteTestFixture.TargetManager].SoloRaidLevels.Add(NewRun());
+        Assert.True(SoloRaidHelper.SetDamageTrial(user, ref response, request, ClassicRouteTestFixture.TargetManager));
+        Assert.Equal(2, user.SoloRaidData[ClassicRouteTestFixture.TargetManager].BattleHistory.Count);
+    }
+
+    [Fact]
+    public void AcceptedBattleIsDurableBeforeAnyProcessExitOrQuit()
+    {
+        var path = Path.Combine(Path.GetTempPath(), "nll-history-" + Guid.NewGuid().ToString("N"), "db.json");
+        var core = new CoreInfo { Users = [ClassicRouteTestFixture.ActiveUser()] };
+        try
+        {
+            var coordinator = new ClassicSoloRaidPersistenceCoordinator(() => core, next => core = next, path);
+            coordinator.Execute(working =>
+            {
+                var response = new ResSetSoloRaidTrialDamage();
+                Assert.True(SoloRaidHelper.SetDamageTrial(working.Users.Single(), ref response,
+                    ClassicRouteTestFixture.DamageRequest(61), ClassicRouteTestFixture.TargetManager));
+                return CoordinatedMutation<bool>.Commit(true);
+            });
+            var restarted = JsonConvert.DeserializeObject<CoreInfo>(File.ReadAllText(path))!;
+            var entry = Assert.Single(restarted.Users.Single().SoloRaidData[ClassicRouteTestFixture.TargetManager].BattleHistory);
+            Assert.Equal(61, entry.Log.Damage);
+            Assert.Equal("open", restarted.Users.Single().SoloRaidData[ClassicRouteTestFixture.TargetManager].BattleRunStatus[entry.RunUid]);
+        }
+        finally
+        {
+            if (File.Exists(path)) File.Delete(path);
+            if (Directory.Exists(Path.GetDirectoryName(path))) Directory.Delete(Path.GetDirectoryName(path)!);
+        }
+    }
+
+    [Fact]
+    public void FinalAndEarlierReceiptReplayReturnsAcceptedAggregateWithoutDuplicateDecks()
+    {
+        var user = ClassicRouteTestFixture.ActiveUser();
+        ResSetSoloRaidTrialDamage? first = null;
+        ResSetSoloRaidTrialDamage? last = null;
+        foreach (var damage in new long[] {20,30,50,10,15})
+        {
+            var response = new ResSetSoloRaidTrialDamage();
+            Assert.True(SoloRaidHelper.SetDamageTrial(user, ref response,
+                ClassicRouteTestFixture.DamageRequest(damage), ClassicRouteTestFixture.TargetManager));
+            first ??= response;
+            last = response;
+        }
+        var before = JsonConvert.SerializeObject(user);
+        var retry = new ResSetSoloRaidTrialDamage();
+        Assert.True(SoloRaidHelper.SetDamageTrial(user, ref retry,
+            ClassicRouteTestFixture.DamageRequest(15), ClassicRouteTestFixture.TargetManager));
+        Assert.Equal(last, retry);
+        Assert.True(SoloRaidHelper.SetDamageTrial(user, ref retry,
+            ClassicRouteTestFixture.DamageRequest(20), ClassicRouteTestFixture.TargetManager));
+        Assert.Equal(first, retry);
+        Assert.Equal(before, JsonConvert.SerializeObject(user));
+    }
+
+    private static SoloRaidLevelData NewRun() => new()
+    {
+        RaidLevel = 8, Type = SoloRaidType.Trial, IsOpen = true, Status = SoloRaidStatus.Alive,
+    };
+}
