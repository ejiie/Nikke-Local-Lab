new file mode 100644
index 0000000..70b1a5a
--- /dev/null
+++ b/EpinelPS/LobbyServer/SafeRequestStageTrace.cs
@@ -0,0 +1,58 @@
+using System.Text;
+using System.Text.Json;
+
+namespace EpinelPS.LobbyServer;
+
+public static class SafeRequestStageTrace
+{
+    public const string OutputPathEnvironmentVariable = "NLL_PHASE3B2_REQUEST_STAGE_LOG";
+
+    private static readonly object Sync = new();
+    private static long ordinal;
+    private static long writeFailureCount;
+
+    public static long WriteFailureCount => Interlocked.Read(ref writeFailureCount);
+
+    public static void Write(string transitionCode, Type? handlerType, bool handlerRegistered)
+    {
+        string? outputPath = Environment.GetEnvironmentVariable(
+            OutputPathEnvironmentVariable,
+            EnvironmentVariableTarget.Process);
+        if (string.IsNullOrWhiteSpace(outputPath))
+            return;
+
+        try
+        {
+            string handlerTypeCode = handlerType?.FullName ?? "unregistered_path";
+            var observation = new
+            {
+                schemaVersion = 1,
+                observedAtUtc = DateTimeOffset.UtcNow.ToString("yyyy-MM-dd'T'HH:mm:ss.fff'Z'"),
+                ordinal = Interlocked.Increment(ref ordinal),
+                transitionCode,
+                handlerTypeCode,
+                handlerRegistered
+            };
+            string line = JsonSerializer.Serialize(observation) + "\n";
+            byte[] bytes = new UTF8Encoding(encoderShouldEmitUTF8Identifier: false)
+                .GetBytes(line);
+
+            lock (Sync)
+            {
+                string? directory = Path.GetDirectoryName(outputPath);
+                if (string.IsNullOrWhiteSpace(directory))
+                    throw new InvalidOperationException("Request stage trace directory is missing");
+
+                Directory.CreateDirectory(directory);
+                using FileStream stream = new(
+                    outputPath,
+                    FileMode.Append,
+                    FileAccess.Write,
+                    FileShare.ReadWrite | FileShare.Delete);
+                stream.Write(bytes, 0, bytes.Length);
+                stream.Flush(flushToDisk: true);
+            }
+        }
+        catch
+        {
+            Interlocked.Increment(ref writeFailureCount);
+        }
+    }
+}
