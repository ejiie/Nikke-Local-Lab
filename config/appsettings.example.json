{
  "paths": {
    "gameRoot": "C:/NIKKE",
    "runtimeRootEnvironmentVariable": "NIKKE_LAB_HOME"
  },
  "network": {
    "bindAddress": "127.0.0.1",
    "port": 17878,
    "lanEnabled": false,
    "allowedCidrs": []
  },
  "database": {
    "provider": "postgresql",
    "connectionStringEnvironmentVariable": "NIKKE_LAB_DB"
  },
  "identity": {
    "hmacSecretEnvironmentVariable": "NIKKE_LAB_ID_SECRET",
    "exposeSourceAliases": false
  },
  "sources": {
    "gameFilesReadOnly": true,
    "allowOfficialNetwork": false,
    "allowAuthenticatedSources": false
  },
  "characterBuildDefaults": {
    "policyId": "combat-max/v1",
    "characterLevel": "unresolved",
    "limitBreak": "max_supported",
    "bond": "max_for_character",
    "equipmentTier": 10,
    "equipmentEnhancementLevel": null,
    "manufacturerMatched": null,
    "cubeLevel": 15,
    "cubeSelection": "unresolved",
    "skillLevels": {
      "skill1": 10,
      "skill2": 10,
      "burst": 10
    },
    "overloadValidationMode": "research",
    "collectionItem": "max_if_applicable",
    "favoriteItem": "max_if_applicable"
  }
}
