{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:nikke-local-lab:launch-context:v1",
  "title": "LaunchContextV1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "contractId",
    "launchContextUid",
    "createdAtUtc",
    "accountUid",
    "accountRevisionSetSha256",
    "seasonNumber",
    "weaknessCode",
    "bossVariantRegistrySha256",
    "bossVariantProfileCode",
    "bossVariantProfileSha256",
    "raidSnapshotUid",
    "raidSnapshotSha256",
    "clientBuildCode",
    "clientExecutableSha256",
    "sourceBossElementCode",
    "sourceBossWeaknessCode",
    "targetBossElementCode",
    "staticDataVariantRequired",
    "staticDataSourceSha256",
    "staticDataVariantSha256",
    "staticDataVariantReceiptSha256",
    "serverDllSha256",
    "serverSourceManifestSha256",
    "parentServerDllSha256",
    "parentServerSourceManifestSha256",
    "runtimeDatabaseSha256",
    "cacheManifestSha256",
    "toolManifestSha256",
    "validationReceiptSha256",
    "statusCode"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "contractId": { "const": "nll/launch-context/v1" },
    "launchContextUid": { "$ref": "#/$defs/uuid" },
    "createdAtUtc": { "type": "string", "format": "date-time" },
    "accountUid": { "$ref": "#/$defs/uuid" },
    "accountRevisionSetSha256": { "$ref": "#/$defs/sha256" },
    "seasonNumber": { "type": "integer", "minimum": 1 },
    "weaknessCode": { "$ref": "#/$defs/elementCode" },
    "bossVariantRegistrySha256": { "$ref": "#/$defs/sha256" },
    "bossVariantProfileCode": { "$ref": "#/$defs/controlledCode" },
    "bossVariantProfileSha256": { "$ref": "#/$defs/sha256" },
    "raidSnapshotUid": { "$ref": "#/$defs/uuid" },
    "raidSnapshotSha256": { "$ref": "#/$defs/sha256" },
    "clientBuildCode": { "$ref": "#/$defs/controlledCode" },
    "clientExecutableSha256": { "$ref": "#/$defs/sha256" },
    "sourceBossElementCode": { "$ref": "#/$defs/elementCode" },
    "sourceBossWeaknessCode": { "$ref": "#/$defs/elementCode" },
    "targetBossElementCode": { "$ref": "#/$defs/elementCode" },
    "staticDataVariantRequired": { "type": "boolean" },
    "staticDataSourceSha256": { "$ref": "#/$defs/sha256" },
    "staticDataVariantSha256": {
      "oneOf": [{ "$ref": "#/$defs/sha256" }, { "type": "null" }]
    },
    "staticDataVariantReceiptSha256": { "$ref": "#/$defs/sha256" },
    "serverDllSha256": { "$ref": "#/$defs/sha256" },
    "serverSourceManifestSha256": { "$ref": "#/$defs/sha256" },
    "parentServerDllSha256": { "$ref": "#/$defs/sha256" },
    "parentServerSourceManifestSha256": { "$ref": "#/$defs/sha256" },
    "runtimeDatabaseSha256": { "$ref": "#/$defs/sha256" },
    "cacheManifestSha256": { "$ref": "#/$defs/sha256" },
    "toolManifestSha256": { "$ref": "#/$defs/sha256" },
    "validationReceiptSha256": { "$ref": "#/$defs/sha256" },
    "statusCode": { "enum": ["draft", "validated", "started", "completed", "failed", "rolled_back"] }
  },
  "$defs": {
    "uuid": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "controlledCode": { "type": "string", "pattern": "^[a-z][a-z0-9._-]{0,63}$" },
    "elementCode": { "enum": ["fire", "water", "wind", "electric", "iron"] }
  }
}
