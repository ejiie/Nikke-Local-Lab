{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:nikke-local-lab:boss-runtime-variant-registry:v1",
  "title": "BossRuntimeVariantRegistryV1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "contractId", "profiles"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "contractId": { "const": "nll/boss-runtime-variant-registry/v1" },
    "profiles": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "seasonNumber",
          "profileCode",
          "profileRelativePath",
          "profileSha256",
          "operationalStatusCode"
        ],
        "properties": {
          "seasonNumber": { "type": "integer", "minimum": 1 },
          "profileCode": { "$ref": "#/$defs/code" },
          "profileRelativePath": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9._/-]+\\.json$",
            "minLength": 6,
            "maxLength": 160
          },
          "profileSha256": { "$ref": "#/$defs/sha256" },
          "operationalStatusCode": {
            "enum": ["enabled", "disabled", "unresolved"]
          }
        }
      }
    }
  },
  "$defs": {
    "code": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9._-]{0,63}$"
    },
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
  }
}
