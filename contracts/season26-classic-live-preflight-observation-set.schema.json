          { "$ref": "#/$defs/loopbackListenersObservation" },
          { "$ref": "#/$defs/targetBindingObservation" },
          { "$ref": "#/$defs/prelistenerBootstrapObservation" },
          { "$ref": "#/$defs/activeRunStateObservation" },
          { "$ref": "#/$defs/logSafetyObservation" }
