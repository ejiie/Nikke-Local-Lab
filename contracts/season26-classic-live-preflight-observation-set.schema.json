        { "contains": { "$ref": "#/$defs/disposableEnvironmentObservation" } },
        { "contains": { "$ref": "#/$defs/primaryInstallObservation" } },
        { "contains": { "$ref": "#/$defs/clientBuildContentObservation" } },
