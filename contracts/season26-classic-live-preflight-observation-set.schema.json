  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "contractId",
    "assessmentUid",
    "observedAtUtc",
    "statusCode",
    "observationCount",
    "canonicalization",
    "observations",
    "canonicalManifest",
    "prohibitedMaterial"
