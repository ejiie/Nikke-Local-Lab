        { "contains": { "$ref": "#/$defs/syntheticIdentityObservation" } },
        { "contains": { "$ref": "#/$defs/processTreeEgressObservation" } },
        { "contains": { "$ref": "#/$defs/mutationBackupRollbackObservation" } },
        { "contains": { "$ref": "#/$defs/localOnlyConfigObservation" } },
        { "contains": { "$ref": "#/$defs/loopbackListenersObservation" } },
        { "contains": { "$ref": "#/$defs/targetBindingObservation" } },
        { "contains": { "$ref": "#/$defs/prelistenerBootstrapObservation" } },
