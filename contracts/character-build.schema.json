{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:nikke-local-lab:character-build:v1",
  "title": "CharacterBuildRevision",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "buildUid",
    "revisionUid",
    "revisionNumber",
    "datasetSnapshotUid",
    "characterUid",
    "defaultPolicy",
    "validationMode",
    "state",
    "readiness"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "buildUid": { "$ref": "#/$defs/uuid" },
    "revisionUid": { "$ref": "#/$defs/uuid" },
    "revisionNumber": { "type": "integer", "minimum": 1 },
    "datasetSnapshotUid": { "$ref": "#/$defs/uuid" },
    "characterUid": { "$ref": "#/$defs/uuid" },
    "defaultPolicy": { "const": "combat-max/v1" },
    "validationMode": { "enum": ["research", "game_legal"] },
    "state": { "$ref": "#/$defs/buildState" },
    "readiness": { "$ref": "#/$defs/readiness" }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "readiness": {
            "type": "object",
            "properties": { "status": { "const": "ready" } },
            "required": ["status"]
          }
        },
        "required": ["readiness"]
      },
      "then": {
        "properties": {
          "state": {
            "type": "object",
            "properties": {
              "characterLevelPolicy": { "not": { "const": "unresolved" } },
              "characterLevel": { "type": "integer", "minimum": 1 },
              "limitBreak": {
                "type": "object",
                "properties": { "resolved": { "const": true } }
              },
              "bond": {
                "type": "object",
                "properties": { "resolved": { "const": true } }
              },
              "equipment": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "equipmentDefinitionUid": { "$ref": "#/$defs/uuid" },
                    "enhancementLevel": { "type": "integer", "minimum": 0 },
                    "manufacturerMatched": { "type": "boolean" }
                  }
                }
              },
              "collectionItem": {
                "type": "object",
                "properties": {
                  "applicability": { "not": { "const": "unresolved" } },
                  "resolved": { "const": true }
                }
              },
              "favoriteItem": {
                "type": "object",
                "properties": {
                  "applicability": { "not": { "const": "unresolved" } },
                  "resolved": { "const": true }
                }
              }
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "uuid": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "nullableNonNegativeInteger": {
      "type": ["integer", "null"],
      "minimum": 0
    },
    "resolvedMaximum": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["policy", "resolved", "value"],
          "properties": {
            "policy": { "const": "unresolved" },
            "resolved": { "const": false },
            "value": { "type": "null" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["policy", "resolved", "value"],
          "properties": {
            "policy": { "enum": ["max_supported", "max_for_character", "explicit"] },
            "resolved": { "const": true },
            "value": { "type": "integer", "minimum": 0 }
          }
        }
      ]
    },
    "limitBreak": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["policy", "resolved", "stage", "coreLevel"],
          "properties": {
            "policy": { "const": "unresolved" },
            "resolved": { "const": false },
            "stage": { "type": "null" },
            "coreLevel": { "type": "null" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["policy", "resolved", "stage", "coreLevel"],
          "properties": {
            "policy": { "enum": ["max_supported", "explicit"] },
            "resolved": { "const": true },
            "stage": { "type": "integer", "minimum": 0 },
            "coreLevel": { "type": "integer", "minimum": 0 }
          }
        }
      ]
    },
    "overloadLine": {
      "type": "object",
      "additionalProperties": false,
      "required": ["lineIndex", "optionType", "exactValue", "unit"],
      "properties": {
        "lineIndex": { "type": "integer", "minimum": 1, "maximum": 3 },
        "optionType": { "type": "string", "minLength": 1 },
        "exactValue": {
          "type": "string",
          "pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]+)?$"
        },
        "unit": { "type": "string", "minLength": 1 }
      }
    },
    "equipment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "slot",
        "equipmentDefinitionUid",
        "tier",
        "enhancementLevel",
        "manufacturerMatched",
        "overloadLines"
      ],
      "properties": {
        "slot": { "enum": ["head", "torso", "arms", "legs"] },
        "equipmentDefinitionUid": {
          "oneOf": [
            { "$ref": "#/$defs/uuid" },
            { "type": "null" }
          ]
        },
        "tier": { "type": "integer", "minimum": 1, "default": 10 },
        "enhancementLevel": {
          "type": ["integer", "null"],
          "minimum": 0,
          "default": 5
        },
        "manufacturerMatched": { "type": ["boolean", "null"] },
        "overloadLines": {
          "type": "array",
          "maxItems": 3,
          "items": { "$ref": "#/$defs/overloadLine" }
        }
      }
    },
    "cube": {
      "oneOf": [
        {
          "title": "UnequippedCube",
          "type": "object",
          "additionalProperties": false,
          "required": ["equipped", "cubeUid", "level"],
          "properties": {
            "equipped": { "const": false },
            "cubeUid": { "type": "null" },
            "level": { "type": "null" }
          }
        },
        {
          "title": "EquippedCube",
          "type": "object",
          "additionalProperties": false,
          "required": ["equipped", "cubeUid", "level"],
          "properties": {
            "equipped": { "const": true },
            "cubeUid": { "$ref": "#/$defs/uuid" },
            "level": {
              "type": "integer",
              "minimum": 1,
              "maximum": 15,
              "default": 15
            }
          }
        }
      ]
    },
    "itemProgress": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["applicability", "policy", "resolved", "level"],
          "properties": {
            "applicability": { "const": "not_applicable" },
            "policy": { "const": "not_applicable" },
            "resolved": { "const": true },
            "level": { "type": "null" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["applicability", "policy", "resolved", "level"],
          "properties": {
            "applicability": { "const": "unresolved" },
            "policy": { "const": "unresolved" },
            "resolved": { "const": false },
            "level": { "type": "null" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["applicability", "policy", "resolved", "level"],
          "properties": {
            "applicability": { "const": "applicable" },
            "policy": { "enum": ["max_available", "explicit"] },
            "resolved": { "const": true },
            "level": { "type": "integer", "minimum": 0 }
          }
        }
      ]
    },
    "buildState": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "characterLevelPolicy",
        "characterLevel",
        "limitBreak",
        "bond",
        "equipment",
        "cube",
        "skills",
        "collectionItem",
        "favoriteItem"
      ],
      "properties": {
        "characterLevelPolicy": { "enum": ["explicit", "max_available", "unresolved"] },
        "characterLevel": {
          "type": ["integer", "null"],
          "minimum": 1
        },
        "limitBreak": { "$ref": "#/$defs/limitBreak" },
        "bond": { "$ref": "#/$defs/resolvedMaximum" },
        "equipment": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "items": { "$ref": "#/$defs/equipment" },
          "allOf": [
            {
              "contains": {
                "type": "object",
                "required": ["slot"],
                "properties": { "slot": { "const": "head" } }
              },
              "minContains": 1,
              "maxContains": 1
            },
            {
              "contains": {
                "type": "object",
                "required": ["slot"],
                "properties": { "slot": { "const": "torso" } }
              },
              "minContains": 1,
              "maxContains": 1
            },
            {
              "contains": {
                "type": "object",
                "required": ["slot"],
                "properties": { "slot": { "const": "arms" } }
              },
              "minContains": 1,
              "maxContains": 1
            },
            {
              "contains": {
                "type": "object",
                "required": ["slot"],
                "properties": { "slot": { "const": "legs" } }
              },
              "minContains": 1,
              "maxContains": 1
            }
          ]
        },
        "cube": { "$ref": "#/$defs/cube" },
        "skills": {
          "type": "object",
          "additionalProperties": false,
          "required": ["skill1", "skill2", "burst"],
          "properties": {
            "skill1": { "type": "integer", "minimum": 1, "maximum": 10 },
            "skill2": { "type": "integer", "minimum": 1, "maximum": 10 },
            "burst": { "type": "integer", "minimum": 1, "maximum": 10 }
          }
        },
        "collectionItem": { "$ref": "#/$defs/itemProgress" },
        "favoriteItem": { "$ref": "#/$defs/itemProgress" }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "characterLevelPolicy": { "const": "unresolved" }
            },
            "required": ["characterLevelPolicy"]
          },
          "then": {
            "properties": {
              "characterLevel": { "type": "null" }
            }
          },
          "else": {
            "properties": {
              "characterLevel": { "type": "integer", "minimum": 1 }
            }
          }
        }
      ]
    },
    "readiness": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "warnings"],
      "properties": {
        "status": { "enum": ["ready", "incomplete", "invalid"] },
        "warnings": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": { "status": { "const": "ready" } },
            "required": ["status"]
          },
          "then": {
            "properties": { "warnings": { "maxItems": 0 } }
          }
        }
      ]
    }
  }
}
