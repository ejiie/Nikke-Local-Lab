{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:nikke-local-lab:original-client-compatibility-gate:v1",
  "title": "OriginalClientCompatibilityGateAssessment",
  "description": "Source-free Phase 3A assessment. It records a fail-closed verdict but is not itself proof that an approval or isolation claim is true.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "contractId",
    "assessmentUid",
    "assessedAtUtc",
    "verdict",
    "route",
    "clientBuild",
    "handshakeContract",
    "sessionBoundary",
    "outboundIsolation",
    "prohibitedTechniques",
    "repositoryBoundary",
    "unresolvedReasonCodes"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "contractId": { "const": "nll/original-client-compatibility-gate/v1" },
    "assessmentUid": { "$ref": "#/$defs/uuid" },
    "assessedAtUtc": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-([0-2][0-9]|3[0-1])T([0-1][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]Z$"
    },
    "verdict": {
      "enum": [
        "blocked_insufficient_evidence",
        "ready_for_phase3b"
      ]
    },
    "route": { "$ref": "#/$defs/route" },
    "clientBuild": { "$ref": "#/$defs/clientBuild" },
    "handshakeContract": { "$ref": "#/$defs/handshakeContract" },
    "sessionBoundary": { "$ref": "#/$defs/sessionBoundary" },
    "outboundIsolation": { "$ref": "#/$defs/outboundIsolation" },
    "prohibitedTechniques": { "$ref": "#/$defs/prohibitedTechniques" },
    "repositoryBoundary": { "$ref": "#/$defs/repositoryBoundary" },
    "unresolvedReasonCodes": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/controlledCode" }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "verdict": { "const": "ready_for_phase3b" }
        },
        "required": ["verdict"]
      },
      "then": {
        "properties": {
          "route": { "$ref": "#/$defs/approvedRoute" },
          "clientBuild": { "$ref": "#/$defs/exactClientBuild" },
          "handshakeContract": { "$ref": "#/$defs/supportedHandshakeContract" },
          "sessionBoundary": { "$ref": "#/$defs/verifiedSessionBoundary" },
          "outboundIsolation": { "$ref": "#/$defs/verifiedOutboundIsolation" },
          "unresolvedReasonCodes": { "maxItems": 0 }
        }
      },
      "else": {
        "properties": {
          "unresolvedReasonCodes": { "minItems": 1 }
        }
      }
    }
  ],
  "$defs": {
    "uuid": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "nullableSha256": {
      "oneOf": [
        { "$ref": "#/$defs/sha256" },
        { "type": "null" }
      ]
    },
    "nullableUuid": {
      "oneOf": [
        { "$ref": "#/$defs/uuid" },
        { "type": "null" }
      ]
    },
    "controlledCode": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9._-]{0,63}$"
    },
    "nullableControlledCode": {
      "oneOf": [
        { "$ref": "#/$defs/controlledCode" },
        { "type": "null" }
      ]
    },
    "route": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "authorizationStatus",
        "scopeStatus",
        "authorizationEvidence",
        "selectorInterfaceCode",
        "selectorEvidence",
        "allowedPurposeCode"
      ],
      "properties": {
        "kind": {
          "enum": [
            "unresolved",
            "rights_holder_approved_local_test"
          ]
        },
        "authorizationStatus": {
          "enum": [
            "not_verified",
            "verified"
          ]
        },
        "scopeStatus": {
          "enum": [
            "not_verified",
            "current"
          ]
        },
        "authorizationEvidence": { "$ref": "#/$defs/nullableEvidenceArtifact" },
        "selectorInterfaceCode": { "$ref": "#/$defs/nullableControlledCode" },
        "selectorEvidence": { "$ref": "#/$defs/nullableEvidenceArtifact" },
        "allowedPurposeCode": { "$ref": "#/$defs/nullableControlledCode" }
      },
      "oneOf": [
        { "$ref": "#/$defs/unresolvedRoute" },
        { "$ref": "#/$defs/approvedRoute" }
      ]
    },
    "unresolvedRoute": {
      "type": "object",
      "properties": {
        "kind": { "const": "unresolved" },
        "authorizationStatus": { "const": "not_verified" },
        "scopeStatus": { "const": "not_verified" },
        "authorizationEvidence": { "type": "null" },
        "selectorInterfaceCode": { "type": "null" },
        "selectorEvidence": { "type": "null" },
        "allowedPurposeCode": { "type": "null" }
      },
      "required": [
        "kind",
        "authorizationStatus",
        "scopeStatus",
        "authorizationEvidence",
        "selectorInterfaceCode",
        "selectorEvidence",
        "allowedPurposeCode"
      ]
    },
    "approvedRoute": {
      "type": "object",
      "properties": {
        "kind": { "const": "rights_holder_approved_local_test" },
        "authorizationStatus": { "const": "verified" },
        "scopeStatus": { "const": "current" },
        "authorizationEvidence": {
          "allOf": [
            { "$ref": "#/$defs/evidenceArtifact" },
            {
              "properties": {
                "kindCode": { "const": "authorization_scope" }
              }
            }
          ]
        },
        "selectorInterfaceCode": { "$ref": "#/$defs/controlledCode" },
        "selectorEvidence": {
          "allOf": [
            { "$ref": "#/$defs/evidenceArtifact" },
            {
              "properties": {
                "kindCode": { "const": "supported_route_selector" }
              }
            }
          ]
        },
        "allowedPurposeCode": { "const": "local_private_server_compatibility" }
      },
      "required": [
        "kind",
        "authorizationStatus",
        "scopeStatus",
        "authorizationEvidence",
        "selectorInterfaceCode",
        "selectorEvidence",
        "allowedPurposeCode"
      ]
    },
    "clientBuild": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "bindingStatus",
        "buildUid",
        "executableObservation",
        "contentSet",
        "adapterContractId"
      ],
      "properties": {
        "bindingStatus": {
          "enum": [
            "unbound",
            "exact"
          ]
        },
        "buildUid": { "$ref": "#/$defs/nullableUuid" },
        "executableObservation": { "$ref": "#/$defs/nullableEvidenceArtifact" },
        "contentSet": {
          "oneOf": [
            { "$ref": "#/$defs/clientContentSet" },
            { "type": "null" }
          ]
        },
        "adapterContractId": {
          "type": ["string", "null"],
          "pattern": "^[a-z][a-z0-9._/-]{0,95}$"
        }
      },
      "oneOf": [
        { "$ref": "#/$defs/unboundClientBuild" },
        { "$ref": "#/$defs/exactClientBuild" }
      ]
    },
    "unboundClientBuild": {
      "type": "object",
      "properties": {
        "bindingStatus": { "const": "unbound" },
        "buildUid": { "type": "null" },
        "executableObservation": { "type": "null" },
        "contentSet": { "type": "null" },
        "adapterContractId": { "type": "null" }
      },
      "required": [
        "bindingStatus",
        "buildUid",
        "executableObservation",
        "contentSet",
        "adapterContractId"
      ]
    },
    "exactClientBuild": {
      "type": "object",
      "properties": {
        "bindingStatus": { "const": "exact" },
        "buildUid": { "$ref": "#/$defs/uuid" },
        "executableObservation": {
          "allOf": [
            { "$ref": "#/$defs/evidenceArtifact" },
            {
              "properties": {
                "kindCode": { "const": "client_executable" }
              }
            }
          ]
        },
        "contentSet": { "$ref": "#/$defs/clientContentSet" },
        "adapterContractId": { "const": "nll/original-client-adapter/v1" }
      },
      "required": [
        "bindingStatus",
        "buildUid",
        "executableObservation",
        "contentSet",
        "adapterContractId"
      ]
    },
    "handshakeContract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "contractId", "evidence"],
      "properties": {
        "status": {
          "enum": [
            "not_verified",
            "supported"
          ]
        },
        "contractId": {
          "type": ["string", "null"],
          "pattern": "^[a-z][a-z0-9._/-]{0,95}$"
        },
        "evidence": { "$ref": "#/$defs/nullableEvidenceArtifact" }
      },
      "oneOf": [
        { "$ref": "#/$defs/unverifiedHandshakeContract" },
        { "$ref": "#/$defs/supportedHandshakeContract" }
      ]
    },
    "unverifiedHandshakeContract": {
      "type": "object",
      "properties": {
        "status": { "const": "not_verified" },
        "contractId": { "type": "null" },
        "evidence": { "type": "null" }
      },
      "required": ["status", "contractId", "evidence"]
    },
    "supportedHandshakeContract": {
      "type": "object",
      "properties": {
        "status": { "const": "supported" },
        "contractId": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9._/-]{0,95}$"
        },
        "evidence": {
          "allOf": [
            { "$ref": "#/$defs/evidenceArtifact" },
            {
              "properties": {
                "kindCode": { "const": "supported_handshake_contract" }
              }
            }
          ]
        }
      },
      "required": ["status", "contractId", "evidence"]
    },
    "sessionBoundary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "syntheticLocalSessionOnly",
        "officialCredentialsUsed",
        "officialSessionMaterialUsed",
        "evidence"
      ],
      "properties": {
        "status": {
          "enum": [
            "not_evaluated",
            "enforcement_plan_ready"
          ]
        },
        "syntheticLocalSessionOnly": { "type": "boolean" },
        "officialCredentialsUsed": { "const": false },
        "officialSessionMaterialUsed": { "const": false },
        "evidence": { "$ref": "#/$defs/nullableEvidenceArtifact" }
      },
      "oneOf": [
        { "$ref": "#/$defs/unevaluatedSessionBoundary" },
        { "$ref": "#/$defs/verifiedSessionBoundary" }
      ]
    },
    "unevaluatedSessionBoundary": {
      "type": "object",
      "properties": {
        "status": { "const": "not_evaluated" },
        "syntheticLocalSessionOnly": { "const": false },
        "officialCredentialsUsed": { "const": false },
        "officialSessionMaterialUsed": { "const": false },
        "evidence": { "type": "null" }
      },
      "required": [
        "status",
        "syntheticLocalSessionOnly",
        "officialCredentialsUsed",
        "officialSessionMaterialUsed",
        "evidence"
      ]
    },
    "verifiedSessionBoundary": {
      "type": "object",
      "properties": {
        "status": { "const": "enforcement_plan_ready" },
        "syntheticLocalSessionOnly": { "const": true },
        "officialCredentialsUsed": { "const": false },
        "officialSessionMaterialUsed": { "const": false },
        "evidence": {
          "allOf": [
            { "$ref": "#/$defs/evidenceArtifact" },
            {
              "properties": {
                "kindCode": { "const": "synthetic_session_enforcement_plan" }
              }
            }
          ]
        }
      },
      "required": [
        "status",
        "syntheticLocalSessionOnly",
        "officialCredentialsUsed",
        "officialSessionMaterialUsed",
        "evidence"
      ]
    },
    "outboundIsolation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "processTreeScopeStatus",
        "coversIpv4",
        "coversIpv6",
        "coversDns",
        "coversTcp",
        "coversUdp",
        "evidence"
      ],
      "properties": {
        "status": {
          "enum": [
            "not_evaluated",
            "verification_plan_ready"
          ]
        },
        "processTreeScopeStatus": {
          "enum": [
            "not_defined",
            "defined"
          ]
        },
        "coversIpv4": { "type": "boolean" },
        "coversIpv6": { "type": "boolean" },
        "coversDns": { "type": "boolean" },
        "coversTcp": { "type": "boolean" },
        "coversUdp": { "type": "boolean" },
        "evidence": { "$ref": "#/$defs/nullableEvidenceArtifact" }
      },
      "oneOf": [
        { "$ref": "#/$defs/unevaluatedOutboundIsolation" },
        { "$ref": "#/$defs/verifiedOutboundIsolation" }
      ]
    },
    "unevaluatedOutboundIsolation": {
      "type": "object",
      "properties": {
        "status": { "const": "not_evaluated" },
        "processTreeScopeStatus": { "const": "not_defined" },
        "coversIpv4": { "const": false },
        "coversIpv6": { "const": false },
        "coversDns": { "const": false },
        "coversTcp": { "const": false },
        "coversUdp": { "const": false },
        "evidence": { "type": "null" }
      },
      "required": [
        "status",
        "processTreeScopeStatus",
        "coversIpv4",
        "coversIpv6",
        "coversDns",
        "coversTcp",
        "coversUdp",
        "evidence"
      ]
    },
    "verifiedOutboundIsolation": {
      "type": "object",
      "properties": {
        "status": { "const": "verification_plan_ready" },
        "processTreeScopeStatus": { "const": "defined" },
        "coversIpv4": { "const": true },
        "coversIpv6": { "const": true },
        "coversDns": { "const": true },
        "coversTcp": { "const": true },
        "coversUdp": { "const": true },
        "evidence": {
          "allOf": [
            { "$ref": "#/$defs/evidenceArtifact" },
            {
              "properties": {
                "kindCode": { "const": "outbound_isolation_verification_plan" }
              }
            }
          ]
        }
      },
      "required": [
        "status",
        "processTreeScopeStatus",
        "coversIpv4",
        "coversIpv6",
        "coversDns",
        "coversTcp",
        "coversUdp",
        "evidence"
      ]
    },
    "evidenceArtifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifactUid", "kindCode", "byteLength", "sha256"],
      "properties": {
        "artifactUid": { "$ref": "#/$defs/uuid" },
        "kindCode": { "$ref": "#/$defs/controlledCode" },
        "byteLength": { "type": "integer", "minimum": 1 },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "nullableEvidenceArtifact": {
      "oneOf": [
        { "$ref": "#/$defs/evidenceArtifact" },
        { "type": "null" }
      ]
    },
    "clientContentSet": {
      "type": "object",
      "additionalProperties": false,
      "description": "Digest of the exact approved-route closure. Each local-only observation is roleCode + TAB + base-10 byteLength without leading zeroes + TAB + lowercase sha256 + LF. Records sort by ordinal roleCode, ordinal sha256, then numeric byteLength and encode as UTF-8 without BOM.",
      "required": ["contractId", "canonicalization", "closureStatus", "memberCount", "canonicalManifestByteLength", "sha256"],
      "properties": {
        "contractId": { "const": "nll/client-content-set/v1" },
        "canonicalization": { "const": "role_length_sha256_lf_ordinal/v1" },
        "closureStatus": { "const": "exact_for_approved_route" },
        "memberCount": { "type": "integer", "minimum": 1 },
        "canonicalManifestByteLength": { "type": "integer", "minimum": 1 },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "prohibitedTechniques": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "endpointOrAuthMutation",
        "officialProtocolReplay",
        "guessedCredentials",
        "processInjection",
        "hooking",
        "memoryPatch",
        "launcherBypass",
        "antiCheatBypass"
      ],
      "properties": {
        "endpointOrAuthMutation": { "const": false },
        "officialProtocolReplay": { "const": false },
        "guessedCredentials": { "const": false },
        "processInjection": { "const": false },
        "hooking": { "const": false },
        "memoryPatch": { "const": false },
        "launcherBypass": { "const": false },
        "antiCheatBypass": { "const": false }
      }
    },
    "repositoryBoundary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "evidenceLocationPolicy",
        "originalArtifactsCommitted",
        "decryptedArtifactsCommitted",
        "patchOutputsCommitted",
        "wireCapturesCommitted",
        "clientLocalReferencesExposed"
      ],
      "properties": {
        "evidenceLocationPolicy": { "const": "local_runtime_only" },
        "originalArtifactsCommitted": { "const": false },
        "decryptedArtifactsCommitted": { "const": false },
        "patchOutputsCommitted": { "const": false },
        "wireCapturesCommitted": { "const": false },
        "clientLocalReferencesExposed": { "const": false }
      }
    }
  }
}
