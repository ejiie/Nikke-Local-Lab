{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:nikke-local-lab:season26-classic-live-preflight:v1",
  "title": "Season26ClassicLivePreflightAssessment",
  "description": "Source-free Phase 3B-2 preflight contract for the pinned disposable season 26 classic Solo Raid reference run. It records only controlled state and irreversible digests; raw game identifiers, paths, credentials, certificates, keys, payloads, decoded data, and binary bytes are forbidden.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "contractId",
    "assessmentUid",
    "assessedAtUtc",
    "verdict",
    "target",
    "externalLineage",
    "environment",
    "runtimeInputs",
    "networkIsolation",
    "mutationRollback",
    "prohibitedMaterial",
    "measuredEvidence",
    "remainingBoundary",
    "blockingReasonCodes",
    "nextStepRequirementCodes"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "contractId": { "const": "nll/season26-classic-live-preflight/v1" },
    "assessmentUid": { "$ref": "#/$defs/uuid" },
    "assessedAtUtc": { "$ref": "#/$defs/utcInstant" },
    "verdict": {
      "enum": [
        "blocked_preflight_incomplete",
        "ready_to_start_isolated_season26_reference_run",
        "blocked_external_pin_drift",
        "blocked_runtime_input_mismatch",
        "blocked_environment_violation"
      ]
    },
    "target": { "$ref": "#/$defs/target" },
    "externalLineage": { "$ref": "#/$defs/externalLineage" },
    "environment": { "$ref": "#/$defs/environment" },
    "runtimeInputs": { "$ref": "#/$defs/runtimeInputs" },
    "networkIsolation": { "$ref": "#/$defs/networkIsolation" },
    "mutationRollback": { "$ref": "#/$defs/mutationRollback" },
    "prohibitedMaterial": { "$ref": "#/$defs/prohibitedMaterial" },
    "measuredEvidence": { "$ref": "#/$defs/measuredEvidence" },
    "remainingBoundary": { "$ref": "#/$defs/preflightBoundary" },
    "blockingReasonCodes": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/controlledCode" }
    },
    "nextStepRequirementCodes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/controlledCode" }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "verdict": { "const": "ready_to_start_isolated_season26_reference_run" }
        },
        "required": ["verdict"]
      },
      "then": {
        "properties": {
          "environment": { "$ref": "#/$defs/readyEnvironment" },
          "runtimeInputs": { "$ref": "#/$defs/readyRuntimeInputs" },
          "networkIsolation": { "$ref": "#/$defs/readyNetworkIsolation" },
          "mutationRollback": { "$ref": "#/$defs/readyMutationRollback" },
          "measuredEvidence": { "$ref": "#/$defs/completeMeasuredEvidence" },
          "blockingReasonCodes": { "maxItems": 0 }
        }
      },
      "else": {
        "properties": {
          "blockingReasonCodes": { "minItems": 1 }
        }
      }
    },
    {
      "if": {
        "properties": {
          "verdict": { "const": "blocked_preflight_incomplete" }
        },
        "required": ["verdict"]
      },
      "then": {
        "properties": {
          "measuredEvidence": { "$ref": "#/$defs/unmeasuredEvidence" }
        }
      }
    },
    {
      "if": {
        "properties": {
          "verdict": { "const": "blocked_external_pin_drift" }
        },
        "required": ["verdict"]
      },
      "then": {
        "properties": {
          "runtimeInputs": {
            "properties": {
              "externalLineageStatusCode": { "const": "mismatch" }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "verdict": { "const": "blocked_runtime_input_mismatch" }
        },
        "required": ["verdict"]
      },
      "then": {
        "properties": {
          "runtimeInputs": {
            "anyOf": [
              {
                "properties": {
                  "clientBuildStatusCode": { "const": "mismatch" }
                }
              },
              {
                "properties": {
                  "reviewedRuntimeInputStatusCode": { "const": "mismatch" }
                }
              }
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "verdict": { "const": "blocked_environment_violation" }
        },
        "required": ["verdict"]
      },
      "then": {
        "anyOf": [
          {
            "properties": {
              "environment": {
                "properties": {
                  "primaryInstallIntegrityStatusCode": { "const": "drift_detected" }
                }
              }
            }
          },
          {
            "properties": {
              "environment": {
                "properties": {
                  "syntheticLocalAccountOnly": { "const": false }
                }
              }
            }
          },
          {
            "properties": {
              "environment": {
                "properties": {
                  "officialAccountMaterialPresent": { "const": true }
                }
              }
            }
          },
          {
            "properties": {
              "networkIsolation": {
                "properties": {
                  "loopbackBindStatusCode": { "const": "violation" }
                }
              }
            }
          },
          {
            "properties": {
              "networkIsolation": {
                "properties": {
                  "nonLoopbackEgressStatusCode": { "const": "violation" }
                }
              }
            }
          }
        ]
      }
    }
  ],
  "$defs": {
    "uuid": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "utcInstant": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-([0-2][0-9]|3[0-1])T([0-1][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]Z$"
    },
    "nullableUtcInstant": {
      "oneOf": [
        { "$ref": "#/$defs/utcInstant" },
        { "type": "null" }
      ]
    },
    "controlledCode": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9._-]{0,95}$"
    },
    "target": {
      "const": {
        "clientBuildVersion": "150.6.9",
        "seasonNumber": 26,
        "modeCode": "classic_solo_raid_challenge",
        "wireModeCode": "trial",
        "challengeRaidLevel": 8,
        "museumAllowed": false,
        "fallbackPolicyCode": "none"
      }
    },
    "externalLineage": {
      "const": {
        "repositoryCode": "epinelps_epinelps",
        "licenseCode": "agpl-3.0-only",
        "sourceBoundaryCode": "external_agpl_checkout",
        "upstreamBaseCommitSha": "28b2f5413a0a1e3521a11ae162f91851335c8b40",
        "selectedManagerIntegrationCommitSha": "92a6ca228aeb580988907b96189b2857dff2c62d",
        "preflightSealCommitSha": "e32e5f900775974d5736e7fb2b50f8c62638a004",
        "preflightHardeningCommitSha": "4f7bd5b5eb2b9a6e03af503f1c09adc4c4f7f16f",
        "latestExternalCommitSha": "519c3db51ec24ca19307e93e85acde7885928a72",
        "latestExternalTreeCommitSha": "b9e8bfb1b1e065427a48d40cb2bcf2f30215436a"
      }
    },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "environmentKindCode",
        "snapshotStatusCode",
        "systemTrustIsolationStatusCode",
        "primaryInstallIntegrityStatusCode",
        "syntheticLocalAccountOnly",
        "officialAccountMaterialPresent",
        "clientExecutionStarted"
      ],
      "properties": {
        "environmentKindCode": {
          "enum": [
            "unresolved",
            "snapshot_capable_disposable_vm",
            "separate_disposable_os"
          ]
        },
        "snapshotStatusCode": {
          "enum": ["not_measured", "ready", "violation"]
        },
        "systemTrustIsolationStatusCode": {
          "enum": ["not_measured", "disposable_environment_only", "violation"]
        },
        "primaryInstallIntegrityStatusCode": {
          "enum": ["not_measured", "unchanged", "drift_detected"]
        },
        "syntheticLocalAccountOnly": { "type": "boolean" },
        "officialAccountMaterialPresent": { "type": "boolean" },
        "clientExecutionStarted": { "const": false }
      }
    },
    "readyEnvironment": {
      "allOf": [
        { "$ref": "#/$defs/environment" },
        {
          "properties": {
            "environmentKindCode": {
              "enum": ["snapshot_capable_disposable_vm", "separate_disposable_os"]
            },
            "snapshotStatusCode": { "const": "ready" },
            "systemTrustIsolationStatusCode": { "const": "disposable_environment_only" },
            "primaryInstallIntegrityStatusCode": { "const": "unchanged" },
            "syntheticLocalAccountOnly": { "const": true },
            "officialAccountMaterialPresent": { "const": false }
          }
        }
      ]
    },
    "runtimeInputs": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "clientBuildStatusCode",
        "externalLineageStatusCode",
        "reviewedRuntimeInputStatusCode",
        "reviewedRuntimeInputExpectedMemberCount",
        "reviewedRuntimeInputObservedMemberCount",
        "canonicalManifest"
      ],
      "properties": {
        "clientBuildStatusCode": {
          "enum": ["not_measured", "exact", "mismatch"]
        },
        "externalLineageStatusCode": {
          "enum": ["not_measured", "exact", "mismatch"]
        },
        "reviewedRuntimeInputStatusCode": {
          "enum": ["not_measured", "exact", "mismatch"]
        },
        "reviewedRuntimeInputExpectedMemberCount": { "const": 4 },
        "reviewedRuntimeInputObservedMemberCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4
        },
        "canonicalManifest": {
          "oneOf": [
            { "$ref": "#/$defs/sourceFreeManifest" },
            { "type": "null" }
          ]
        }
      }
    },
    "readyRuntimeInputs": {
      "allOf": [
        { "$ref": "#/$defs/runtimeInputs" },
        {
          "properties": {
            "clientBuildStatusCode": { "const": "exact" },
            "externalLineageStatusCode": { "const": "exact" },
            "reviewedRuntimeInputStatusCode": { "const": "exact" },
            "reviewedRuntimeInputObservedMemberCount": { "const": 4 },
            "canonicalManifest": { "$ref": "#/$defs/sourceFreeManifest" }
          }
        }
      ]
    },
    "networkIsolation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "processTreeScopeStatusCode",
        "loopbackBindStatusCode",
        "nonLoopbackEgressStatusCode",
        "coversIpv4",
        "coversIpv6",
        "coversDns",
        "coversTcp",
        "coversUdp",
        "canonicalManifest"
      ],
      "properties": {
        "processTreeScopeStatusCode": {
          "enum": ["not_measured", "complete", "violation"]
        },
        "loopbackBindStatusCode": {
          "enum": ["not_measured", "exact_127_0_0_1", "violation"]
        },
        "nonLoopbackEgressStatusCode": {
          "enum": ["not_measured", "blocked", "violation"]
        },
        "coversIpv4": { "type": "boolean" },
        "coversIpv6": { "type": "boolean" },
        "coversDns": { "type": "boolean" },
        "coversTcp": { "type": "boolean" },
        "coversUdp": { "type": "boolean" },
        "canonicalManifest": {
          "oneOf": [
            { "$ref": "#/$defs/sourceFreeManifest" },
            { "type": "null" }
          ]
        }
      }
    },
    "readyNetworkIsolation": {
      "allOf": [
        { "$ref": "#/$defs/networkIsolation" },
        {
          "properties": {
            "processTreeScopeStatusCode": { "const": "complete" },
            "loopbackBindStatusCode": { "const": "exact_127_0_0_1" },
            "nonLoopbackEgressStatusCode": { "const": "blocked" },
            "coversIpv4": { "const": true },
            "coversIpv6": { "const": true },
            "coversDns": { "const": true },
            "coversTcp": { "const": true },
            "coversUdp": { "const": true },
            "canonicalManifest": { "$ref": "#/$defs/sourceFreeManifest" }
          }
        }
      ]
    },
    "mutationRollback": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "statusCode",
        "systemHostsStatusCode",
        "rootCaStatusCode",
        "clientCertificateBundleStatusCode",
        "nativeCompatibilityShimStatusCode",
        "canonicalManifest"
      ],
      "properties": {
        "statusCode": { "enum": ["not_prepared", "prepared", "violation"] },
        "systemHostsStatusCode": { "$ref": "#/$defs/mutationPreparationCode" },
        "rootCaStatusCode": { "$ref": "#/$defs/mutationPreparationCode" },
        "clientCertificateBundleStatusCode": { "$ref": "#/$defs/mutationPreparationCode" },
        "nativeCompatibilityShimStatusCode": { "$ref": "#/$defs/mutationPreparationCode" },
        "canonicalManifest": {
          "oneOf": [
            { "$ref": "#/$defs/sourceFreeManifest" },
            { "type": "null" }
          ]
        }
      }
    },
    "mutationPreparationCode": {
      "enum": [
        "not_measured",
        "not_applicable",
        "sealed_with_backup_and_rollback",
        "violation"
      ]
    },
    "readyMutationRollback": {
      "allOf": [
        { "$ref": "#/$defs/mutationRollback" },
        {
          "properties": {
            "statusCode": { "const": "prepared" },
            "systemHostsStatusCode": {
              "enum": ["not_applicable", "sealed_with_backup_and_rollback"]
            },
            "rootCaStatusCode": {
              "enum": ["not_applicable", "sealed_with_backup_and_rollback"]
            },
            "clientCertificateBundleStatusCode": {
              "enum": ["not_applicable", "sealed_with_backup_and_rollback"]
            },
            "nativeCompatibilityShimStatusCode": {
              "enum": ["not_applicable", "sealed_with_backup_and_rollback"]
            },
            "canonicalManifest": { "$ref": "#/$defs/sourceFreeManifest" }
          }
        }
      ]
    },
    "sourceFreeManifest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contractId",
        "canonicalizationCode",
        "memberCount",
        "canonicalByteLength",
        "sha256"
      ],
      "properties": {
        "contractId": {
          "type": "string",
          "pattern": "^nll/[a-z0-9._/-]{1,91}/v[1-9][0-9]*$"
        },
        "canonicalizationCode": { "$ref": "#/$defs/controlledCode" },
        "memberCount": { "type": "integer", "minimum": 1, "maximum": 4096 },
        "canonicalByteLength": { "type": "integer", "minimum": 1 },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "measuredEvidence": {
      "oneOf": [
        { "$ref": "#/$defs/unmeasuredEvidence" },
        { "$ref": "#/$defs/completeMeasuredEvidence" }
      ]
    },
    "unmeasuredEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["statusCode", "observationCount", "canonicalManifest"],
      "properties": {
        "statusCode": { "const": "not_measured" },
        "observationCount": { "const": 0 },
        "canonicalManifest": { "type": "null" }
      }
    },
    "completeMeasuredEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["statusCode", "observationCount", "canonicalManifest"],
      "properties": {
        "statusCode": { "const": "measured_complete" },
        "observationCount": { "type": "integer", "minimum": 1, "maximum": 4096 },
        "canonicalManifest": { "$ref": "#/$defs/sourceFreeManifest" }
      }
    },
    "prohibitedMaterial": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rawGameIdentifiersIncluded",
        "localPathsIncluded",
        "officialCredentialsIncluded",
        "officialSessionMaterialIncluded",
        "certificateMaterialIncluded",
        "privateKeysIncluded",
        "rawPayloadsIncluded",
        "decodedRowsIncluded",
        "originalAssetsIncluded",
        "patchedBinaryBytesIncluded",
        "wireCapturesIncluded"
      ],
      "properties": {
        "rawGameIdentifiersIncluded": { "const": false },
        "localPathsIncluded": { "const": false },
        "officialCredentialsIncluded": { "const": false },
        "officialSessionMaterialIncluded": { "const": false },
        "certificateMaterialIncluded": { "const": false },
        "privateKeysIncluded": { "const": false },
        "rawPayloadsIncluded": { "const": false },
        "decodedRowsIncluded": { "const": false },
        "originalAssetsIncluded": { "const": false },
        "patchedBinaryBytesIncluded": { "const": false },
        "wireCapturesIncluded": { "const": false }
      }
    },
    "preflightBoundary": {
      "const": {
        "referenceRunExecuted": false,
        "originalClientBattleStarted": false,
        "originalClientResultVerified": false,
        "localLabShadowBridgeVerified": false,
        "phase3cVerified": false,
        "phase3dVerified": false,
        "phase4Verified": false,
        "nextPhaseCode": "phase3b2_isolated_season26_reference_run"
      }
    }
  }
}
