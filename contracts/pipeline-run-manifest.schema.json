{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:nikke-local-lab:pipeline-run-manifest:v1",
  "title": "PipelineRunManifestV1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "contractId", "pipelineUid", "target", "inputs", "steps"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "contractId": { "const": "nll/pipeline-run-manifest/v1" },
    "pipelineUid": { "$ref": "#/$defs/uuid" },
    "target": { "$ref": "#/$defs/target" },
    "inputs": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/input" }
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/step" }
    }
  },
  "$defs": {
    "uuid": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "controlledCode": { "type": "string", "pattern": "^[a-z][a-z0-9._-]{0,63}$" },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kindCode", "seasonNumber", "clientBuildCode", "modeCode"],
      "properties": {
        "kindCode": { "$ref": "#/$defs/controlledCode" },
        "seasonNumber": { "type": ["integer", "null"], "minimum": 1 },
        "clientBuildCode": { "$ref": "#/$defs/controlledCode" },
        "modeCode": { "$ref": "#/$defs/controlledCode" }
      }
    },
    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": ["roleCode", "relativePath", "byteLength", "sha256"],
      "properties": {
        "roleCode": { "$ref": "#/$defs/controlledCode" },
        "relativePath": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?![A-Za-z]:)(?!/)(?!.*(^|/)\\.\\.(/|$)).+$"
        },
        "byteLength": { "type": "integer", "minimum": 0 },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "action": {
      "type": "object",
      "additionalProperties": false,
      "required": ["actionCode", "targetRoleCode"],
      "properties": {
        "actionCode": { "$ref": "#/$defs/controlledCode" },
        "targetRoleCode": { "$ref": "#/$defs/controlledCode" }
      }
    },
    "step": {
      "type": "object",
      "additionalProperties": false,
      "required": ["stepId", "kindCode", "mutation", "dependencyStepIds", "outputRoleCodes", "actions", "rollbackActions"],
      "properties": {
        "stepId": { "$ref": "#/$defs/controlledCode" },
        "kindCode": {
          "enum": ["inventory", "validate", "project", "build", "stage", "run", "complete", "promote", "backup"]
        },
        "mutation": { "type": "boolean" },
        "dependencyStepIds": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/controlledCode" }
        },
        "outputRoleCodes": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/controlledCode" }
        },
        "actions": { "type": "array", "items": { "$ref": "#/$defs/action" } },
        "rollbackActions": { "type": "array", "items": { "$ref": "#/$defs/action" } }
      }
    }
  }
}
